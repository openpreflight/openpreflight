package empty

import "github.com/openpreflight/openpreflight/internal/web/utils"

type Props struct {
	ID         string
	Class      string
	Attributes templ.Attributes
}

type HeaderProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
}

type MediaVariant string

const (
	MediaVariantDefault MediaVariant = "default"
	MediaVariantIcon    MediaVariant = "icon"
)

type MediaProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
	Variant    MediaVariant
}

type TitleProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
}

type DescriptionProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
}

type ContentProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
}

func mediaClasses(variant MediaVariant) string {
	return utils.CN("mb-2 flex shrink-0 items-center justify-center bg-transparent [&_svg]:pointer-events-none [&_svg]:shrink-0")
}

templ Empty(props ...Props) {
	{{ var p Props }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<div
		if p.ID != "" {
			id={ p.ID }
		}
		data-slot="empty"
		class={
			utils.CN(
				"bg-muted flex w-full min-w-0 flex-col items-center justify-center gap-4 rounded-xl border px-6 py-16 text-center",
				p.Class,
			),
		}
		{ p.Attributes... }
	>
		{ children... }
	</div>
}

templ Header(props ...HeaderProps) {
	{{ var p HeaderProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<div
		if p.ID != "" {
			id={ p.ID }
		}
		data-slot="empty-header"
		class={ utils.CN("flex max-w-lg flex-col items-center gap-2", p.Class) }
		{ p.Attributes... }
	>
		{ children... }
	</div>
}

templ Media(props ...MediaProps) {
	{{ var p MediaProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	if p.Variant == "" {
		{{ p.Variant = MediaVariantDefault }}
	}
	if p.Variant == MediaVariantIcon {
		// Three plates on a shared skew read as one stack seen from the side.
		// The icon rides the front plate's transform rather than fighting it.
		<div
			if p.ID != "" {
				id={ p.ID }
			}
			data-slot="empty-icon"
			data-variant={ string(p.Variant) }
			class={ utils.CN("relative mb-2 h-20 w-24 shrink-0", p.Class) }
			aria-hidden="true"
			{ p.Attributes... }
		>
			<div class="bg-card absolute top-5 left-1 size-14 -skew-y-6 rounded-xl border shadow-xs"></div>
			<div class="bg-card absolute top-3 left-5 size-14 -skew-y-6 rounded-xl border shadow-xs"></div>
			<div class="bg-card text-muted-foreground absolute top-1 left-9 flex size-14 -skew-y-6 items-center justify-center rounded-xl border shadow-md [&_svg:not([class*='size-'])]:size-5">
				{ children... }
			</div>
		</div>
	} else {
		<div
			if p.ID != "" {
				id={ p.ID }
			}
			data-slot="empty-icon"
			data-variant={ string(p.Variant) }
			class={ utils.CN(mediaClasses(p.Variant), p.Class) }
			{ p.Attributes... }
		>
			{ children... }
		</div>
	}
}

templ Title(props ...TitleProps) {
	{{ var p TitleProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<div
		if p.ID != "" {
			id={ p.ID }
		}
		data-slot="empty-title"
		class={ utils.CN("text-base font-semibold tracking-tight", p.Class) }
		{ p.Attributes... }
	>
		{ children... }
	</div>
}

templ Description(props ...DescriptionProps) {
	{{ var p DescriptionProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<div
		if p.ID != "" {
			id={ p.ID }
		}
		data-slot="empty-description"
		class={
			utils.CN(
				"text-muted-foreground max-w-lg text-sm/relaxed [&>a]:underline [&>a]:underline-offset-4 [&>a:hover]:text-primary",
				p.Class,
			),
		}
		{ p.Attributes... }
	>
		{ children... }
	</div>
}

templ Content(props ...ContentProps) {
	{{ var p ContentProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<div
		if p.ID != "" {
			id={ p.ID }
		}
		data-slot="empty-content"
		class={
			utils.CN(
				"flex min-w-0 flex-wrap items-center justify-center gap-2 text-sm",
				p.Class,
			),
		}
		{ p.Attributes... }
	>
		{ children... }
	</div>
}
