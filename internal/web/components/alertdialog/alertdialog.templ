package alertdialog

import (
	"context"

	"github.com/openpreflight/openpreflight/internal/web/components/button"
	"github.com/openpreflight/openpreflight/internal/web/utils"
)

type ctxKey string

const stateKey ctxKey = "alertDialogState"

type Size string

const (
	SizeDefault Size = "default"
	SizeSm      Size = "sm"
)

type ctxState struct {
	id         string
	open       bool
	controlled bool
}

func state(ctx context.Context) ctxState {
	if s, ok := ctx.Value(stateKey).(ctxState); ok {
		return s
	}
	return ctxState{}
}

type Props struct {
	ID string
	// Open is the controlled open state. Use DefaultOpen when the browser
	// should own the state after the initial render.
	Open        *bool
	DefaultOpen bool
}

func initialOpen(p Props) bool {
	if p.Open != nil {
		return *p.Open
	}
	return p.DefaultOpen
}

type ContentProps struct {
	Class      string
	Attributes templ.Attributes
	// Size of the alert dialog. Defaults to default.
	Size Size
}

type HeaderProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
}

type FooterProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
}

type MediaProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
}

type TitleProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
}

type DescriptionProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
}

type ActionProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
	Variant    button.Variant
	Size       button.Size
}

type CancelProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
	// Variant of the cancel button. Defaults to outline, like shadcn.
	Variant button.Variant
	Size    button.Size
}

// AlertDialog renders no element: it only carries the id and options that
// link Trigger, Content and Cancel (via ctx). Like shadcn, the alert dialog
// IS the dialog primitive without light dismiss; the dialog script drives it.
templ AlertDialog(props ...Props) {
	{{ var p Props }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	if p.ID == "" {
		{{ p.ID = utils.RandomID() }}
	}
	{{ ctx = context.WithValue(ctx, stateKey, ctxState{id: p.ID, open: initialOpen(p), controlled: p.Open != nil}) }}
	{ children... }
}

// Trigger returns the attributes that turn any element (usually a button)
// into the alert dialog trigger — the asChild equivalent: no wrapper element.
func Trigger(ctx context.Context) templ.Attributes {
	return TriggerFor(state(ctx).id)
}

// TriggerFor targets an alert dialog outside the current AlertDialog root by id.
func TriggerFor(id string) templ.Attributes {
	return templ.Attributes{
		"data-tui-dialog-trigger": true,
		"aria-controls":           id,
		"aria-haspopup":           "dialog",
		"aria-expanded":           "false",
	}
}

// Close returns the attributes that make any element close the alert dialog.
func Close(ctx context.Context) templ.Attributes {
	return CloseFor(state(ctx).id)
}

// CloseFor targets an alert dialog outside the current AlertDialog root by id.
func CloseFor(id string) templ.Attributes {
	return templ.Attributes{
		"data-tui-dialog-close":  true,
		"data-tui-dialog-target": id,
	}
}

// PortalProps is AlertDialogPortal's surface: the portal node renders no
// visible element of its own.
type PortalProps struct {
	Attributes templ.Attributes
}

// Portal is 1:1 base/ui/alert-dialog.tsx AlertDialogPortal. Inert until the
// script portals it to <body> at init; it shares the dialog machinery's
// data attributes because Base UI's AlertDialog composes Dialog.
templ Portal(props ...PortalProps) {
	{{ var p PortalProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<template data-tui-dialog-portal>
		<div data-tui-dialog-root hidden { p.Attributes... }>
			{ children... }
		</div>
	</template>
}

type OverlayProps struct {
	ID         string
	Class      string
	Attributes templ.Attributes
}

// Overlay is 1:1 base/ui/alert-dialog.tsx AlertDialogOverlay
// (AlertDialog.Backdrop): the look comes from.
// user-select none is Base UI's inline style on the backdrop.
templ Overlay(props ...OverlayProps) {
	{{ var p OverlayProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<div
		if p.ID != "" {
			id={ p.ID }
		}
		data-slot="alert-dialog-overlay"
		data-tui-dialog-backdrop
		role="presentation"
		style="user-select: none; -webkit-user-select: none;"
		class={ utils.CN("data-open:animate-in data-closed:animate-out data-closed:fade-out-0 data-open:fade-in-0 bg-black/10 duration-100 supports-backdrop-filter:backdrop-blur-xs fixed inset-0 isolate z-50", p.Class) }
		{ p.Attributes... }
	></div>
}

templ Content(props ...ContentProps) {
	{{ var p ContentProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	if p.Size == "" {
		{{ p.Size = SizeDefault }}
	}
	{{ s := state(ctx) }}
	// Base UI's AlertDialog is a Dialog with disablePointerDismissal locked
	// on: a press on the backdrop never closes it (disable-dismissible on
	// the popup), only Esc and the buttons do.
	@Portal() {
		@Overlay()
		// 1:1 base/ui/alert-dialog.tsx AlertDialogContent
		// (AlertDialog.Popup): the look comes from.
		<div
			id={ s.id }
			role="alertdialog"
			tabindex="-1"
			data-slot="alert-dialog-content"
			data-tui-dialog-content
			data-size={ string(p.Size) }
			data-tui-dialog-initial-open={ utils.IfElse(s.open, "true", "false") }
			data-tui-dialog-controlled?={ s.controlled }
			data-tui-dialog-show-modal="true"
			data-tui-dialog-disable-dismissible="true"
			class={
				utils.CN(
					"data-open:animate-in data-closed:animate-out data-closed:fade-out-0 data-open:fade-in-0 data-closed:zoom-out-95 data-open:zoom-in-95 bg-popover text-popover-foreground ring-foreground/10 gap-4 rounded-xl p-4 ring-1 duration-100 data-[size=default]:max-w-xs data-[size=sm]:max-w-xs data-[size=default]:sm:max-w-sm group/alert-dialog-content fixed top-1/2 left-1/2 z-50 grid w-full -translate-x-1/2 -translate-y-1/2 outline-none",
					p.Class,
				),
			}
			{ p.Attributes... }
		>
			{ children... }
		</div>
	}
}

templ Header(props ...HeaderProps) {
	{{ var p HeaderProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<div
		if p.ID != "" {
			id={ p.ID }
		}
		data-slot="alert-dialog-header"
		class={ utils.CN("grid grid-rows-[auto_1fr] place-items-center gap-1.5 text-center has-data-[slot=alert-dialog-media]:grid-rows-[auto_auto_1fr] has-data-[slot=alert-dialog-media]:gap-x-4 sm:group-data-[size=default]/alert-dialog-content:place-items-start sm:group-data-[size=default]/alert-dialog-content:text-left sm:group-data-[size=default]/alert-dialog-content:has-data-[slot=alert-dialog-media]:grid-rows-[auto_1fr]", p.Class) }
		{ p.Attributes... }
	>
		{ children... }
	</div>
}

templ Footer(props ...FooterProps) {
	{{ var p FooterProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<div
		if p.ID != "" {
			id={ p.ID }
		}
		data-slot="alert-dialog-footer"
		class={ utils.CN("bg-muted/50 -mx-4 -mb-4 rounded-b-xl border-t p-4 flex flex-col-reverse gap-2 group-data-[size=sm]/alert-dialog-content:grid group-data-[size=sm]/alert-dialog-content:grid-cols-2 sm:flex-row sm:justify-end", p.Class) }
		{ p.Attributes... }
	>
		{ children... }
	</div>
}

templ Media(props ...MediaProps) {
	{{ var p MediaProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<div
		if p.ID != "" {
			id={ p.ID }
		}
		data-slot="alert-dialog-media"
		class={ utils.CN("bg-muted mb-2 inline-flex size-10 items-center justify-center rounded-md sm:group-data-[size=default]/alert-dialog-content:row-span-2 *:[svg:not([class*='size-'])]:size-6", p.Class) }
		{ p.Attributes... }
	>
		{ children... }
	</div>
}

templ Title(props ...TitleProps) {
	{{ var p TitleProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<div
		if p.ID != "" {
			id={ p.ID }
		}
		data-slot="alert-dialog-title"
		data-tui-dialog-title
		class={ utils.CN("text-base font-medium sm:group-data-[size=default]/alert-dialog-content:group-has-data-[slot=alert-dialog-media]/alert-dialog-content:col-start-2", p.Class) }
		{ p.Attributes... }
	>
		{ children... }
	</div>
}

templ Description(props ...DescriptionProps) {
	{{ var p DescriptionProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	<div
		if p.ID != "" {
			id={ p.ID }
		}
		data-slot="alert-dialog-description"
		data-tui-dialog-description
		class={ utils.CN("text-muted-foreground *:[a]:hover:text-foreground text-sm text-balance md:text-pretty *:[a]:underline *:[a]:underline-offset-3", p.Class) }
		{ p.Attributes... }
	>
		{ children... }
	</div>
}

// Action is a plain button, exactly like shadcn's AlertDialogAction: it does
// not close the alert dialog by itself. Spread alertdialog.Close(ctx) into
// Attributes (or submit a form) to wire the confirm behavior.
templ Action(props ...ActionProps) {
	{{ var p ActionProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	{{
		attrs := templ.Attributes{"data-slot": "alert-dialog-action"}
		for k, v := range p.Attributes {
			attrs[k] = v
		}
	}}
	@button.Button(button.Props{
		ID:         p.ID,
		Variant:    p.Variant,
		Size:       p.Size,
		Class:      utils.CN("", p.Class),
		Attributes: attrs,
	}) {
		{ children... }
	}
}

// Cancel closes the alert dialog, rendered as an outline button like shadcn.
templ Cancel(props ...CancelProps) {
	{{ var p CancelProps }}
	if len(props) > 0 {
		{{ p = props[0] }}
	}
	if p.Variant == "" {
		{{ p.Variant = button.VariantOutline }}
	}
	{{
		attrs := templ.Attributes{
			"data-slot":              "alert-dialog-cancel",
			"data-tui-dialog-close":  true,
			"data-tui-dialog-target": state(ctx).id,
		}
		for k, v := range p.Attributes {
			attrs[k] = v
		}
	}}
	@button.Button(button.Props{
		ID:         p.ID,
		Variant:    p.Variant,
		Size:       p.Size,
		Class:      utils.CN("", p.Class),
		Attributes: attrs,
	}) {
		{ children... }
	}
}
