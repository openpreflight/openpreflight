package layouts

import "github.com/openpreflight/openpreflight/internal/web/components/icon"

// Tone is the one colour vocabulary every state in the product maps to: a
// job, an App, a Coolify instance, a health component, a binding. Five tones,
// so the same colour always means the same thing.
type Tone string

const (
	ToneSuccess Tone = "success"
	ToneDanger  Tone = "danger"
	ToneWarning Tone = "warning"
	ToneInfo    Tone = "info"
	// ToneLive is info that is happening now: a running job. The dot pulses.
	ToneLive    Tone = "live"
	ToneNeutral Tone = "neutral"
)

// The class strings live in this .templ file, not a .go file, because
// Tailwind only scans .templ under layouts/.
func toneClass(t Tone) string {
	switch t {
	case ToneSuccess:
		return "border-success/30 bg-success/10 text-success"
	case ToneDanger:
		return "border-destructive/30 bg-destructive/10 text-destructive"
	case ToneWarning:
		return "border-warning/35 bg-warning/10 text-warning"
	case ToneInfo, ToneLive:
		return "border-info/35 bg-info/10 text-info"
	default:
		return "border-border bg-muted text-muted-foreground"
	}
}

func noticeClass(t Tone) string {
	switch t {
	case ToneDanger:
		return "border-destructive/30 bg-destructive/5 [&>svg]:text-destructive"
	case ToneWarning:
		return "border-warning/35 bg-warning/5 [&>svg]:text-warning"
	case ToneSuccess:
		return "border-success/30 bg-success/5 [&>svg]:text-success"
	default:
		return "border-info/30 bg-info/5 [&>svg]:text-info"
	}
}

// Status is a state pill: a dot and a word. Every list and header uses it, so
// "failed" on the Jobs page and "failed" on the Apps page look the same.
templ Status(label string, tone Tone) {
	<span data-tone={ string(tone) } class={ "inline-flex shrink-0 items-center gap-1.5 rounded-full border px-2 py-0.5 text-xs leading-4 font-medium whitespace-nowrap", toneClass(tone) }>
		<span class={ "size-1.5 shrink-0 rounded-full bg-current", templ.KV("dot-live", tone == ToneLive) } aria-hidden="true"></span>
		{ label }
	</span>
}

// Notice is an inline message about a state that persists: a job's error, an
// instance's last failed check. It stays on the page until the state changes.
// A toast is for "you just did X"; it is gone in seconds and must never be
// the only place a standing problem is shown.
templ Notice(tone Tone, title, body string) {
	if title != "" || body != "" {
		<div role={ noticeRole(tone) } class={ "flex gap-3 rounded-lg border px-3.5 py-3 text-sm [&>svg]:mt-0.5 [&>svg]:size-4 [&>svg]:shrink-0", noticeClass(tone) }>
			if tone == ToneDanger || tone == ToneWarning {
				@icon.CircleAlert()
			} else {
				@icon.Info()
			}
			<div class="min-w-0 flex-1 space-y-1">
				if title != "" {
					<p class="font-medium">{ title }</p>
				}
				if body != "" {
					<p class="text-muted-foreground text-pretty [overflow-wrap:anywhere]">{ body }</p>
				}
				{ children... }
			</div>
		</div>
	}
}

func noticeRole(t Tone) string {
	if t == ToneDanger {
		return "alert"
	}
	return "status"
}

// ListCard is the one container for a list of objects: jobs, repos, Apps,
// instances, health components. Header, then rows separated by rules.
//
// Two tones: the header sits on a muted frame and the content in an inset
// panel. Every child after the head becomes its own panel, so a toolbar and
// its list go in one wrapper when they belong together.
templ ListCard() {
	<section data-slot="list-card" class="bg-muted/60 text-card-foreground mb-6 rounded-xl border p-1">
		{ children... }
	</section>
}

// ListHead titles a ListCard. count < 0 hides the count. Children are the
// header's actions (a filter, a link).
templ ListHead(title string, count int, hint string) {
	<div data-slot="list-head" class="flex flex-wrap items-center justify-between gap-x-4 gap-y-2 px-3 pt-2 pb-2.5">
		<div class="min-w-0">
			<h2 class="text-sm font-semibold">
				{ title }
				if count >= 0 {
					<span class="text-muted-foreground ml-1 font-normal tabular-nums">{ itoa(count) }</span>
				}
			</h2>
			if hint != "" {
				<p class="text-muted-foreground mt-0.5 text-xs text-pretty">{ hint }</p>
			}
		</div>
		<div class="flex flex-wrap items-center gap-2">
			{ children... }
		</div>
	</div>
}

// List holds the rows. A row is an <li> with RowClass; its main link takes
// "row-link" so the whole row is the click target, and any control in the row
// takes "relative z-10" to stay clickable above it.
templ List() {
	<ul role="list" class="divide-y">
		{ children... }
	</ul>
}

const RowClass = "relative flex flex-wrap items-center gap-x-4 gap-y-2 px-4 py-3 transition-colors has-[.row-link]:hover:bg-muted/40"

// GitHubMark is GitHub's own mark (Octicons mark-github, MIT), filled. The
// outline icon set's version is a stroke drawing that turns to a smudge at
// row-icon size.
templ GitHubMark(class string) {
	<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true" class={ class }>
		<path d="M8 0c4.42 0 8 3.58 8 8a8.013 8.013 0 0 1-5.45 7.59c-.4.08-.55-.17-.55-.38 0-.27.01-1.13.01-2.2 0-.75-.25-1.23-.54-1.48 1.78-.2 3.65-.88 3.65-3.95 0-.88-.31-1.59-.82-2.15.08-.2.36-1.02-.08-2.12 0 0-.67-.22-2.2.82-.64-.18-1.32-.27-2-.27-.68 0-1.36.09-2 .27-1.53-1.03-2.2-.82-2.2-.82-.44 1.1-.16 1.92-.08 2.12-.51.56-.82 1.28-.82 2.15 0 3.06 1.86 3.75 3.64 3.95-.23.2-.44.55-.51 1.07-.46.21-1.61.55-2.33-.66-.15-.24-.6-.83-1.23-.82-.67.01-.27.38.01.53.34.19.73.9.82 1.13.16.45.68 1.31 2.69.94 0 .67.01 1.3.01 1.49 0 .21-.15.45-.55.38A7.995 7.995 0 0 1 0 8c0-4.42 3.58-8 8-8Z"></path>
	</svg>
}

// RowMenu is the "more actions" menu at the end of a row: the row shows its
// one likely action as a button, everything else lives here. The menu is a
// native popover, so it sits in the browser's top layer: no row, list panel
// or stacking context can draw over it or clip it, and outside clicks and
// Escape close it without script. The script in Base only places it.
templ RowMenu(id, label string) {
	<button type="button" popovertarget={ id } aria-haspopup="menu" aria-label={ label } title="More actions" class="text-muted-foreground hover:bg-muted hover:text-foreground flex size-8 shrink-0 cursor-pointer items-center justify-center rounded-md">
		@icon.Ellipsis(icon.Props{Class: "size-4"})
	</button>
	<div id={ id } popover="auto" role="menu" data-row-menu class="bg-popover text-popover-foreground m-0 min-w-48 rounded-lg border p-1 shadow-lg [inset:auto]">
		{ children... }
	</div>
}

// Menu item classes. A link, a form's submit button or a dialog trigger all
// take one of these so every menu reads the same.
const (
	MenuItemClass   = "hover:bg-muted focus-visible:bg-muted flex w-full cursor-pointer outline-none items-center gap-2 rounded-md px-2 py-1.5 text-left text-sm [&>svg]:size-3.5 [&>svg]:text-muted-foreground"
	MenuDangerClass = "hover:bg-destructive/10 focus-visible:bg-destructive/10 text-destructive flex w-full cursor-pointer outline-none items-center gap-2 rounded-md px-2 py-1.5 text-left text-sm"
)

templ MenuSeparator() {
	<div role="separator" class="bg-border -mx-1 my-1 h-px"></div>
}
