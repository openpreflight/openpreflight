package pages

import (
	"github.com/openpreflight/openpreflight/internal/executor"
	"github.com/openpreflight/openpreflight/internal/store"
	"github.com/openpreflight/openpreflight/internal/web"
	"github.com/openpreflight/openpreflight/internal/web/components/alert"
	"github.com/openpreflight/openpreflight/internal/web/components/badge"
	"github.com/openpreflight/openpreflight/internal/web/components/button"
	"github.com/openpreflight/openpreflight/internal/web/components/card"
	"github.com/openpreflight/openpreflight/internal/web/components/empty"
	"github.com/openpreflight/openpreflight/internal/web/components/icon"
	"github.com/openpreflight/openpreflight/internal/web/components/skeleton"
	"github.com/openpreflight/openpreflight/internal/web/components/table"
	"github.com/openpreflight/openpreflight/internal/web/layouts"
)

templ Run(p web.Page) {
	{{ m := asMap(p.Data) }}
	{{ job := jobOf(m) }}
	{{ steps := stepsOf(m) }}
	{{ logBody := str(m, "Log") }}
	{{ shared := asBool(m, "Shared") }}
	{{ commitURL := str(m, "CommitURL") }}
	if p.User != nil {
		@layouts.Shell(p) {
			@runBody(p, job, steps, logBody, shared, commitURL)
		}
	} else {
		@layouts.Guest(p) {
			@runBody(p, job, steps, logBody, shared, commitURL)
		}
	}
}

templ runBody(p web.Page, job store.Job, steps []executor.Result, logBody string, shared bool, commitURL string) {
	{{ origins := originsOf(job) }}
	@layouts.PageHead(job.Repo, "") {
		if p.User != nil {
			<form method="post" action={ templ.SafeURL("/api/v1/jobs/" + job.ID + "/rerun") } class="m-0">
				@layouts.CSRF(p.CSRFToken)
				@button.Button(button.Props{Type: button.TypeSubmit, Size: button.SizeSm}) {
					Re-run
				}
			</form>
			if job.InFlight() {
				@layouts.Confirm(layouts.ConfirmProps{
					ID:             "cancel-run-" + job.ID,
					Token:          p.CSRFToken,
					Action:         "/api/v1/jobs/" + job.ID + "/cancel",
					Trigger:        "Cancel",
					TriggerVariant: button.VariantDestructive,
					Title:          "Cancel this run?",
					Description:    "The runner stops where it is and the Check Run is reported as cancelled. Re-running starts the whole pipeline again.",
					Confirm:        "Cancel the run",
					Dismiss:        "Keep running",
				})
			}
		}
	}
	<div class="text-muted-foreground mb-6 flex flex-wrap items-center gap-2 text-sm">
		@StatusBadge(job)
		if commitURL != "" {
			<a class="text-primary font-mono hover:underline" href={ templ.SafeURL(commitURL) }>{ web.ShortSHA(job.SHA) }</a>
		} else {
			<span class="font-mono">{ web.ShortSHA(job.SHA) }</span>
		}
		if job.Ref != "" {
			<span>on <span class="font-mono">{ job.Ref }</span></span>
		}
		<span>· { job.Event }</span>
		if job.StartedAt != nil {
			<span>· { web.HumanDuration(job.Duration()) }</span>
		}
		<span>· { web.Ago(job.CreatedAt) }</span>
		if job.ShareableLogs {
			@badge.Badge(badge.Props{Variant: badge.VariantOutline}) {
				shareable
			}
		} else {
			@badge.Badge(badge.Props{Variant: badge.VariantSecondary}) {
				private
			}
		}
		if job.IsFork {
			@badge.Badge(badge.Props{Variant: badge.VariantSecondary}) {
				fork
				if job.PullNumber != 0 {
					#{ itoa(job.PullNumber) }
				}
			}
		}
	</div>
	@card.Card(card.Props{Class: "mb-6"}) {
		@card.Header() {
			@card.Title() {
				Run
			}
		}
		@card.Content() {
			@detailList() {
				@detailRow("Job") {
					<span class="font-mono">{ job.ID }</span>
				}
				@detailRow("Check run") {
					if job.CheckRunID != 0 {
						<span class="font-mono">{ itoa64(job.CheckRunID) }</span>
					} else {
						<span class="text-muted-foreground">not created</span>
					}
				}
				@detailRow("Delivery") {
					if job.DeliveryID != "" {
						<span class="font-mono">{ job.DeliveryID }</span>
					} else {
						<span class="text-muted-foreground">{ "-" }</span>
					}
				}
				@detailRow("Executor") {
					if job.Runtime != "" {
						<span class="font-mono">docker: { job.Runtime }</span>
					} else if job.Status == store.JobSkipped {
						<span class="text-muted-foreground">{ "-" }</span>
					} else {
						worker process
					}
				}
				@detailRow("Plan from") {
					if job.PlanSource != "" {
						<span class="font-mono">{ job.PlanSource }</span>
					} else {
						<span class="text-muted-foreground">{ "-" }</span>
					}
				}
				@detailRow("Check name") {
					if job.CheckName != "" {
						{ job.CheckName }
					} else {
						<span class="text-muted-foreground">inherited</span>
					}
				}
				@detailRow("Log size") {
					<span class="tabular-nums">{ itoa64(job.LogBytes) } bytes</span>
				}
				if job.Error != "" {
					@detailRow("Error") {
						<span class="text-destructive">{ job.Error }</span>
					}
				}
			}
		}
	}
	if len(steps) > 0 {
		@card.Card(card.Props{Class: "mb-6"}) {
			@card.Header() {
				@card.Title() {
					Steps
				}
			}
			@card.Content() {
				@table.Table() {
					@table.Header() {
						@table.Row() {
							@table.Head() {
								<span class="sr-only">Result</span>
							}
							@table.Head() {
								Step
							}
							@table.Head() {
								Command
							}
							@table.Head() {
								Took
							}
						}
					}
					@table.Body() {
						for _, s := range steps {
							@table.Row() {
								@table.Cell(table.CellProps{Class: "font-mono"}) {
									{ s.Mark() }
								}
								@table.Cell() {
									{ s.Name }
								}
								@table.Cell(table.CellProps{Class: "font-mono text-xs"}) {
									{ s.Command }
								}
								@table.Cell(table.CellProps{Class: "text-xs"}) {
									if s.Skipped {
										{ "-" }
									} else {
										{ web.HumanDuration(s.Duration) }
									}
								}
							}
						}
					}
				}
			}
		}
	}
	if len(origins) > 0 {
		@card.Card(card.Props{Class: "mb-6"}) {
			@card.Header() {
				@card.Title() {
					Where every value came from
				}
				@card.Description() {
					Recorded when this commit was resolved, so it says what applied to this run and not what would apply today.
				}
			}
			@card.Content() {
				@originsTable(origins)
			}
		}
	}
	if job.InFlight() || logBody != "" {
		@card.Card(card.Props{Class: "bg-muted"}) {
			@card.Header() {
				@card.Title() {
					Log
				}
				if job.InFlight() {
					@card.Action() {
						// Says which of the three things is true: streaming,
						// reconnect needed, or finished. Without it a stalled
						// stream is indistinguishable from a slow build.
						<span id="job-log-state" class="text-muted-foreground text-xs" role="status" aria-live="polite">connecting…</span>
					}
				}
			}
			@card.Content() {
				<pre id="job-log" data-job-id={ job.ID } class="max-h-[32rem] overflow-auto font-mono text-xs whitespace-pre-wrap">{ logBody }</pre>
				if job.InFlight() {
					// Hidden until the stream actually gives up. Inside the
					// card rather than after it: it is about this log, and a
					// notice that floats free of the panel reads as a page error.
					@alert.Alert(alert.Props{ID: "job-log-error", Variant: alert.VariantDestructive, Class: "mt-3 hidden"}) {
						@alert.Title() {
							The log stream disconnected
						}
						@alert.Description() {
							The run is still going on the server — this page stopped receiving it. Reload to pick the log back up.
						}
					}
				}
				if job.InFlight() && logBody == "" {
					// The runner has the job but has not written a byte yet.
					// An empty <pre> reads as "no output"; this reads as "not yet".
					<div id="job-log-waiting" class="space-y-2">
						@skeleton.Skeleton(skeleton.Props{Class: "h-3 w-2/5"})
						@skeleton.Skeleton(skeleton.Props{Class: "h-3 w-4/5"})
						@skeleton.Skeleton(skeleton.Props{Class: "h-3 w-3/5"})
					</div>
				}
			}
		}
		if job.InFlight() {
			@runLogStream()
		}
	} else {
		@empty.Empty() {
			@empty.Header() {
				@empty.Media(empty.MediaProps{Variant: empty.MediaVariantIcon}) {
					@icon.ScrollText()
				}
				@empty.Title() {
					No log yet
				}
				@empty.Description() {
					The log appears when the runner starts, or after the job finishes writing it.
				}
			}
		}
	}
	if shared {
		<p class="text-muted-foreground mt-3 text-xs">You are viewing this with a shareable link. Anyone holding the URL can read this build output.</p>
	}
}

templ runLogStream() {
	<script>
		(function () {
			var pre = document.getElementById("job-log");
			if (!pre || !window.EventSource) return;
			var state = document.getElementById("job-log-state");
			var failure = document.getElementById("job-log-error");
			var waiting = document.getElementById("job-log-waiting");
			function say(text) { if (state) state.textContent = text; }
			function stopWaiting() {
				if (waiting) { waiting.remove(); waiting = null; }
			}
			var es = new EventSource("/api/v1/jobs/" + pre.getAttribute("data-job-id") + "/logs/stream");
			es.onopen = function () {
				pre.textContent = "";
				say("streaming");
				// The meta refresh is the fallback for browsers that never got
				// a stream. Once one is open it would throw away scroll position.
				var m = document.querySelector('meta[http-equiv="refresh"]');
				if (m) m.remove();
			};
			es.onmessage = function (ev) {
				stopWaiting();
				pre.appendChild(document.createTextNode(ev.data));
				pre.scrollTop = pre.scrollHeight;
			};
			es.addEventListener("finished", function () {
				es.close();
				stopWaiting();
				say("finished");
			});
			// EventSource retries on its own, but a closed stream is terminal:
			// say so rather than leaving a log that has quietly stopped growing.
			es.onerror = function () {
				if (es.readyState !== EventSource.CLOSED) {
					say("reconnecting…");
					return;
				}
				stopWaiting();
				say("disconnected");
				if (failure) failure.classList.remove("hidden");
			};
		})();
	</script>
}
