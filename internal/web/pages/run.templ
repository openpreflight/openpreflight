package pages

import (
	"github.com/openpreflight/openpreflight/internal/executor"
	"github.com/openpreflight/openpreflight/internal/store"
	"github.com/openpreflight/openpreflight/internal/web"
	"github.com/openpreflight/openpreflight/internal/web/components/button"
	"github.com/openpreflight/openpreflight/internal/web/components/card"
	"github.com/openpreflight/openpreflight/internal/web/components/empty"
	"github.com/openpreflight/openpreflight/internal/web/components/icon"
	"github.com/openpreflight/openpreflight/internal/web/components/skeleton"
	"github.com/openpreflight/openpreflight/internal/web/layouts"
)

templ Run(p web.Page) {
	{{ m := asMap(p.Data) }}
	{{ job := jobOf(m) }}
	{{ steps := stepsOf(m) }}
	{{ logBody := str(m, "Log") }}
	{{ shared := asBool(m, "Shared") }}
	{{ commitURL := str(m, "CommitURL") }}
	if p.User != nil {
		@layouts.Shell(p) {
			@runBody(p, job, steps, logBody, shared, commitURL)
		}
	} else {
		@layouts.Guest(p) {
			@runBody(p, job, steps, logBody, shared, commitURL)
		}
	}
}

templ runBody(p web.Page, job store.Job, steps []executor.Result, logBody string, shared bool, commitURL string) {
	{{ origins := originsOf(job) }}
	@layouts.PageHead(job.Repo, "") {
		if p.User != nil {
			<form method="post" action={ templ.SafeURL("/api/v1/jobs/" + job.ID + "/rerun") } class="m-0">
				@layouts.CSRF(p.CSRFToken)
				@button.Button(button.Props{Type: button.TypeSubmit, Size: button.SizeSm}) {
					Re-run
				}
			</form>
			if job.InFlight() {
				@layouts.Confirm(layouts.ConfirmProps{
					ID:             "cancel-run-" + job.ID,
					Token:          p.CSRFToken,
					Action:         "/api/v1/jobs/" + job.ID + "/cancel",
					Trigger:        "Cancel",
					TriggerVariant: button.VariantDestructive,
					Title:          "Cancel this run?",
					Description:    "The runner stops where it is and the Check Run is reported as cancelled. Re-running starts the whole pipeline again.",
					Confirm:        "Cancel the run",
					Dismiss:        "Keep running",
				})
			}
		}
	}
	<div class="-mt-4 mb-6 flex flex-wrap items-center gap-x-2.5 gap-y-2 text-sm">
		@StatusBadge(job)
		<span class="font-medium">{ jobRefLabel(job) }</span>
		if commitURL != "" {
			<a class="text-muted-foreground inline-flex items-center gap-1 font-mono text-xs hover:text-foreground hover:underline" href={ templ.SafeURL(commitURL) } target="_blank" rel="noopener" title="Open the commit on GitHub">
				{ web.ShortSHA(job.SHA) }
				@icon.ExternalLink(icon.Props{Class: "size-3"})
			</a>
		} else {
			<span class="text-muted-foreground font-mono text-xs">{ web.ShortSHA(job.SHA) }</span>
		}
		<span class="text-muted-foreground" aria-hidden="true">·</span>
		<span class="text-muted-foreground text-xs">{ eventLabel(job) }</span>
		if job.StartedAt != nil {
			<span class="text-muted-foreground" aria-hidden="true">·</span>
			<span class="text-muted-foreground text-xs tabular-nums">{ web.HumanDuration(job.Duration()) }</span>
		}
		<span class="text-muted-foreground" aria-hidden="true">·</span>
		<span class="text-muted-foreground text-xs">{ web.Ago(job.CreatedAt) }</span>
		if job.ShareableLogs {
			@layouts.Status("public logs", layouts.ToneWarning)
		}
		if job.IsFork {
			@layouts.Status("fork", layouts.ToneNeutral)
		}
	</div>
	if job.Error != "" || job.SkipReason != "" {
		<div class="mb-6">
			if job.Error != "" {
				@layouts.Notice(layouts.ToneDanger, "The run stopped with an error", job.Error)
			} else {
				@layouts.Notice(layouts.ToneInfo, "Skipped", skipReasonLabel(job.SkipReason))
			}
		</div>
	}
	if len(steps) > 0 {
		@layouts.ListCard() {
			@layouts.ListHead("Steps", len(steps), "")
			@layouts.List() {
				for _, s := range steps {
					<li class="grid grid-cols-[1.25rem_minmax(0,1fr)_auto] items-start gap-x-3 px-4 py-2.5">
						<span class={ stepMarkClass(s) } aria-hidden="true">{ s.Mark() }</span>
						<div class="min-w-0">
							<p class="text-sm font-medium">
								{ s.Name }
								<span class="sr-only">{ stepResultWord(s) }</span>
							</p>
							if s.Command != "" {
								<code class="text-muted-foreground mt-0.5 block truncate font-mono text-xs" title={ s.Command }>{ s.Command }</code>
							}
							if s.Err != "" {
								<p class="text-destructive mt-0.5 text-xs [overflow-wrap:anywhere]">{ s.Err }</p>
							}
						</div>
						<span class="text-muted-foreground pt-0.5 text-xs tabular-nums">
							if s.Skipped {
								skipped
							} else {
								{ web.HumanDuration(s.Duration) }
							}
						</span>
					</li>
				}
			}
		}
	}
	if job.InFlight() || logBody != "" {
		@card.Card(card.Props{Class: "check-run mb-8 gap-0 overflow-hidden rounded-xl border-[#2a2f2a] bg-[#121412] py-0 text-[#e8ebe6]"}) {
			<div class="flex h-11 items-center justify-between gap-3 border-b border-white/10 px-4">
				<span class="font-mono text-xs tracking-wide text-white/55">Log</span>
				if job.InFlight() {
					<span id="job-log-state" class="font-mono text-xs text-white/45" role="status" aria-live="polite">connecting…</span>
				}
			</div>
			<div class="px-4 py-3">
				<pre id="job-log" data-job-id={ job.ID } class="max-h-[32rem] overflow-auto font-mono text-xs leading-relaxed whitespace-pre-wrap">{ logBody }</pre>
				if job.InFlight() && logBody == "" {
					<div id="job-log-waiting" class="space-y-2 py-2">
						@skeleton.Skeleton(skeleton.Props{Class: "h-3 w-2/5 bg-white/10"})
						@skeleton.Skeleton(skeleton.Props{Class: "h-3 w-4/5 bg-white/10"})
						@skeleton.Skeleton(skeleton.Props{Class: "h-3 w-3/5 bg-white/10"})
					</div>
				}
			</div>
		}
		if job.InFlight() {
			@runLogStream()
		}
	} else {
		@empty.Empty(empty.Props{Class: "mb-8"}) {
			@empty.Header() {
				@empty.Media(empty.MediaProps{Variant: empty.MediaVariantIcon}) {
					@icon.ScrollText()
				}
				@empty.Title() {
					No log yet
				}
				@empty.Description() {
					The log appears when the runner starts, or after the job finishes writing it.
				}
			}
		}
	}
	@layouts.ListCard() {
		@layouts.ListHead("Details", -1, "")
		<div class="p-4">
			@detailList() {
				@detailRow("Job") {
					<span class="font-mono">{ job.ID }</span>
				}
				@detailRow("Check run") {
					if job.CheckRunID != 0 {
						<span class="font-mono">{ itoa64(job.CheckRunID) }</span>
					} else {
						<span class="text-muted-foreground">not created</span>
					}
				}
				@detailRow("Delivery") {
					if job.DeliveryID != "" {
						<span class="font-mono">{ job.DeliveryID }</span>
					} else {
						<span class="text-muted-foreground">{ "-" }</span>
					}
				}
				@detailRow("Executor") {
					if job.Runtime != "" {
						<span class="font-mono">docker: { job.Runtime }</span>
					} else if job.Status == store.JobSkipped {
						<span class="text-muted-foreground">{ "-" }</span>
					} else {
						worker process
					}
				}
				@detailRow("Plan from") {
					if job.PlanSource != "" {
						<span class="font-mono">{ job.PlanSource }</span>
					} else {
						<span class="text-muted-foreground">{ "-" }</span>
					}
				}
				@detailRow("Check name") {
					if job.CheckName != "" {
						{ job.CheckName }
					} else {
						<span class="text-muted-foreground">inherited</span>
					}
				}
				@detailRow("Log size") {
					<span class="tabular-nums">{ humanBytes(job.LogBytes) }</span>
				}
			}
		</div>
	}
	if len(origins) > 0 {
		@layouts.ListCard() {
			@layouts.ListHead("Where every value came from", -1, "Recorded when this commit was resolved, so it says what applied to this run and not what would apply today.")
			@originsTable(origins)
		}
	}
	if shared {
		<p class="text-muted-foreground mt-3 text-xs">You are viewing this with a shareable link. Anyone holding the URL can read this build output.</p>
	}
}

templ runLogStream() {
	<script>
		(function () {
			var pre = document.getElementById("job-log");
			if (!pre || !window.EventSource) return;
			var state = document.getElementById("job-log-state");
			var waiting = document.getElementById("job-log-waiting");
			function say(text) { if (state) state.textContent = text; }
			function stopWaiting() {
				if (waiting) { waiting.remove(); waiting = null; }
			}
			var es = new EventSource("/api/v1/jobs/" + pre.getAttribute("data-job-id") + "/logs/stream");
			es.onopen = function () {
				pre.textContent = "";
				say("streaming");
				// The meta refresh is the fallback for browsers that never got
				// a stream. Once one is open it would throw away scroll position.
				var m = document.querySelector('meta[http-equiv="refresh"]');
				if (m) m.remove();
			};
			es.onmessage = function (ev) {
				stopWaiting();
				pre.appendChild(document.createTextNode(ev.data));
				pre.scrollTop = pre.scrollHeight;
			};
			es.addEventListener("finished", function () {
				es.close();
				stopWaiting();
				say("finished");
			});
			// EventSource retries on its own, but a closed stream is terminal:
			// say so rather than leaving a log that has quietly stopped growing.
			es.onerror = function () {
				if (es.readyState !== EventSource.CLOSED) {
					say("reconnecting…");
					return;
				}
				stopWaiting();
				say("disconnected");
				if (window.tui && window.tui.toast) {
					window.tui.toast.add({
						type: "error",
						title: "Log stream disconnected",
						description: "The run is still going on the server — reload to pick the log back up.",
						timeout: 14000,
					});
				}
			};
		})();
	</script>
}
