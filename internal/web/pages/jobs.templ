package pages

import (
	"github.com/openpreflight/openpreflight/internal/store"
	"github.com/openpreflight/openpreflight/internal/web"
	"github.com/openpreflight/openpreflight/internal/web/components/button"
	"github.com/openpreflight/openpreflight/internal/web/components/icon"
	"github.com/openpreflight/openpreflight/internal/web/components/input"
	"github.com/openpreflight/openpreflight/internal/web/components/pagination"
	selectcomp "github.com/openpreflight/openpreflight/internal/web/components/select"
	"github.com/openpreflight/openpreflight/internal/web/layouts"
)

templ Jobs(p web.Page) {
	{{ m := asMap(p.Data) }}
	{{ settings := settingsOf(m) }}
	{{ list := jobsOf(m) }}
	{{ repo := jobRepoOf(m) }}
	{{ status := jobStatusOf(m) }}
	@layouts.Shell(p) {
		@layouts.PageHead("Jobs", "Every run this worker has taken, newest first. "+retentionLabel(settings.LogRetentionDays))
		@layouts.ListCard() {
			@jobsFilter(repo, status)
			if len(list) > 0 {
				@jobList(p, list, true)
			} else {
				@jobsEmpty(jobFiltered(m))
			}
		}
		@jobsPager(m, len(list))
	}
}

// jobsFilter is the list's header. Picking a status reloads at once; the repo
// box submits on Enter.
templ jobsFilter(repo, status string) {
	<form method="get" action="/jobs" class="flex flex-wrap items-center gap-2 border-b px-4 py-3" aria-label="Filter jobs" onchange="this.requestSubmit()">
		@selectcomp.Select(selectcomp.Props{ID: "status-list", Name: "status", DefaultValue: status}) {
			@selectcomp.Trigger(selectcomp.TriggerProps{ID: "status", Class: "w-[10rem] shrink-0", Attributes: templ.Attributes{"aria-label": "Status"}}) {
				@selectcomp.Value(selectcomp.ValueProps{Placeholder: allStatuses})
			}
			@selectcomp.Content(selectcomp.ContentProps{DisableAlignItemWithTrigger: true, Align: selectcomp.AlignStart}) {
				@selectcomp.Item(selectcomp.ItemProps{Value: ""}) {
					{ allStatuses }
				}
				for _, st := range store.JobStatuses {
					@selectcomp.Item(selectcomp.ItemProps{Value: st}) {
						{ statusLabel(st) }
					}
				}
			}
		}
		<div class="relative order-last min-w-0 basis-full sm:order-none sm:max-w-xs sm:flex-1 sm:basis-auto">
			@icon.Search(icon.Props{Class: "text-muted-foreground pointer-events-none absolute top-1/2 left-2.5 size-3.5 -translate-y-1/2"})
			@input.Input(input.Props{
				ID:          "repo",
				Name:        "repo",
				Type:        "search",
				Placeholder: "Filter by repo, owner/name",
				Value:       repo,
				Class:       "pl-8",
				Attributes:  templ.Attributes{"aria-label": "Repo", "autocomplete": "off", "spellcheck": "false"},
			})
		</div>
		@button.Button(button.Props{Type: button.TypeSubmit, Size: button.SizeSm, Variant: button.VariantSecondary}) {
			Filter
		}
		if repo != "" || status != "" {
			@button.Button(button.Props{Href: "/jobs", Variant: button.VariantGhost, Size: button.SizeSm}) {
				Clear
			}
		}
	</form>
}

templ jobsPager(m map[string]any, n int) {
	{{ repo := jobRepoOf(m) }}
	{{ status := jobStatusOf(m) }}
	{{ limit := jobLimitOf(m) }}
	{{ offset := jobOffsetOf(m) }}
	if offset > 0 || n == limit {
		// The list is keyset-free: the server knows there is a next page only
		// because this one came back full. So there is no last page to jump to
		// and no total to count against - Previous, where you are, Next.
		@pagination.Pagination(pagination.Props{Class: "mt-4 justify-start", Attributes: templ.Attributes{"aria-label": "Jobs pagination"}}) {
			@pagination.Content() {
				@pagination.Item() {
					@pagination.Previous(pagination.PreviousProps{
						Href:     jobsPath(repo, status, limit, jobPrevOffset(offset, limit)),
						Disabled: offset == 0,
					})
				}
				@pagination.Item() {
					@pagination.Link(pagination.LinkProps{IsActive: true, Attributes: templ.Attributes{"aria-current": "page"}}) {
						{ itoa(jobPageNumber(offset, limit)) }
					}
				}
				@pagination.Item() {
					@pagination.Next(pagination.NextProps{
						Href:     jobsPath(repo, status, limit, offset+limit),
						Disabled: n < limit,
					})
				}
			}
		}
	}
}
