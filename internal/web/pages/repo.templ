package pages

import (
	"github.com/openpreflight/openpreflight/internal/web"
	"github.com/openpreflight/openpreflight/internal/web/components/button"
	"github.com/openpreflight/openpreflight/internal/web/components/empty"
	"github.com/openpreflight/openpreflight/internal/web/components/icon"
	"github.com/openpreflight/openpreflight/internal/web/layouts"
)

// Repo is one repository's own page: what it is configured to do, and what it
// has actually been doing. The dashboard cards and the jobs table both answer
// "what happened to this commit"; this answers "what happens to this repo".
templ Repo(p web.Page) {
	{{ m := asMap(p.Data) }}
	{{ b := bindingKeyOf(m, "Binding") }}
	{{ jobs := jobsOf(m) }}
	{{ last := jobOf(m) }}
	@layouts.Shell(p) {
		@layouts.PageHead(b.Repo, repoSubtitle(b)) {
			@button.Button(button.Props{Href: "/repos/" + itoa64(b.ID) + "/resolve", Variant: button.VariantOutline, Size: button.SizeSm}) {
				Dry run
			}
			@button.Button(button.Props{Href: "/repos/" + itoa64(b.ID) + "/edit", Size: button.SizeSm}) {
				Edit
			}
		}
		<div class="grid gap-x-6 lg:grid-cols-2">
			@layouts.ListCard() {
				@layouts.ListHead("Last run", -1, "")
				<div class="p-4">
					if last.ID != "" {
						<div class="mb-3 flex flex-wrap items-center gap-2 text-sm">
							@StatusBadge(last)
							<a class="font-medium hover:underline" href={ templ.SafeURL("/runs/" + last.ID) }>{ jobRefLabel(last) }</a>
							<span class="text-muted-foreground font-mono text-xs">{ web.ShortSHA(last.SHA) }</span>
						</div>
						@detailList() {
							@detailRow("Duration") {
								if last.StartedAt != nil {
									<span class="tabular-nums">{ web.HumanDuration(last.Duration()) }</span>
								} else {
									<span class="text-muted-foreground">{ "-" }</span>
								}
							}
							@detailRow("When") {
								{ web.Ago(last.CreatedAt) }
							}
							@detailRow("Trigger") {
								{ eventLabel(last) }
							}
							if repoFailureReason(last) != "" {
								@detailRow("Why") {
									<span class={ whyClass(last) }>{ repoFailureReason(last) }</span>
								}
							}
						}
					} else {
						@empty.Empty(empty.Props{Class: emptyInCardClass}) {
							@empty.Header() {
								@empty.Media(empty.MediaProps{Variant: empty.MediaVariantIcon}) {
									@icon.Github()
								}
								@empty.Title() {
									No runs yet
								}
								@empty.Description() {
									Push a commit, or re-run an existing one, and the Check Run appears here.
								}
							}
						}
					}
				</div>
			}
			@layouts.ListCard() {
				@layouts.ListHead("Configuration", -1, "")
				<div class="p-4">
					@detailList() {
						@detailRow("Enabled") {
							@bindingStatus(b.Enabled)
						}
						@detailRow("Branches") {
							<span class="font-mono">{ orAll(b.Branches) }</span>
						}
						@detailRow("Paths") {
							<span class="font-mono">{ orAll(b.Paths) }</span>
						}
						@detailRow("Pipeline file") {
							<span class="font-mono">{ orDefault(b.PipelineFile, ".ci.yml") }</span>
						}
						@detailRow("Check name") {
							{ orDefault(b.CheckName, "inherited") }
						}
						@detailRow("Empty pipeline") {
							{ orDefault(b.OnEmptyPipeline, "skip") }
						}
					}
				</div>
			}
		</div>
		@layouts.ListCard() {
			@layouts.ListHead("Recent runs", len(jobs), "") {
				@button.Button(button.Props{Href: "/jobs?repo=" + b.Repo, Variant: button.VariantLink, Size: button.SizeSm, Class: "h-auto px-0"}) {
					All runs
				}
			}
			if len(jobs) > 0 {
				@jobList(p, jobs, false)
			} else {
				<p class="text-muted-foreground px-4 py-8 text-center text-sm">No runs yet.</p>
			}
		}
	}
}
