package pages

import (
	"github.com/openpreflight/openpreflight/internal/web"
	"github.com/openpreflight/openpreflight/internal/web/components/badge"
	"github.com/openpreflight/openpreflight/internal/web/components/button"
	"github.com/openpreflight/openpreflight/internal/web/components/card"
	"github.com/openpreflight/openpreflight/internal/web/components/empty"
	"github.com/openpreflight/openpreflight/internal/web/components/icon"
	"github.com/openpreflight/openpreflight/internal/web/layouts"
)

// Repo is one repository's own page: what it is configured to do, and what it
// has actually been doing. The dashboard cards and the jobs table both answer
// "what happened to this commit"; this answers "what happens to this repo".
templ Repo(p web.Page) {
	{{ m := asMap(p.Data) }}
	{{ b := bindingKeyOf(m, "Binding") }}
	{{ jobs := jobsOf(m) }}
	{{ last := jobOf(m) }}
	@layouts.Shell(p) {
		@layouts.PageHead(b.Repo, repoSubtitle(b)) {
			@button.Button(button.Props{Href: "/repos/" + itoa64(b.ID) + "/resolve", Variant: button.VariantOutline, Size: button.SizeSm}) {
				Dry run
			}
			@button.Button(button.Props{Href: "/repos/" + itoa64(b.ID) + "/edit", Size: button.SizeSm}) {
				Edit
			}
		}
		<div class="mb-6 grid gap-4 lg:grid-cols-2">
			@card.Card() {
				@card.Header() {
					@card.Title() {
						Last run
					}
				}
				@card.Content() {
					if last.ID != "" {
						<div class="mb-3 flex flex-wrap items-center gap-2 text-sm">
							@StatusBadge(last)
							<a class="text-primary font-mono text-xs hover:underline" href={ templ.SafeURL("/runs/" + last.ID) }>
								{ web.ShortSHA(last.SHA) }
							</a>
							if last.Ref != "" {
								<span class="text-muted-foreground font-mono text-xs">{ last.Ref }</span>
							}
						</div>
						<dl class="grid gap-2 text-sm sm:grid-cols-[7rem_1fr]">
							<dt class="text-muted-foreground">Duration</dt>
							<dd class="text-xs tabular-nums">
								if last.StartedAt != nil {
									{ web.HumanDuration(last.Duration()) }
								} else {
									{ "-" }
								}
							</dd>
							<dt class="text-muted-foreground">When</dt>
							<dd class="text-xs">{ web.Ago(last.CreatedAt) }</dd>
							<dt class="text-muted-foreground">Trigger</dt>
							<dd class="text-xs">{ last.Event }</dd>
							if repoFailureReason(last) != "" {
								<dt class="text-muted-foreground">Why</dt>
								<dd class="text-xs">{ repoFailureReason(last) }</dd>
							}
						</dl>
					} else {
						@empty.Empty(empty.Props{Class: "border-0 px-0 py-4"}) {
							@empty.Header() {
								@empty.Media(empty.MediaProps{Variant: empty.MediaVariantIcon}) {
									@icon.Github()
								}
								@empty.Title() {
									No runs yet
								}
								@empty.Description() {
									Push a commit, or re-run an existing one, and the Check Run appears here.
								}
							}
						}
					}
				}
			}
			@card.Card() {
				@card.Header() {
					@card.Title() {
						Configuration
					}
				}
				@card.Content() {
					<dl class="grid gap-2 text-sm sm:grid-cols-[7rem_1fr]">
						<dt class="text-muted-foreground">Enabled</dt>
						<dd class="text-xs">
							if b.Enabled {
								@badge.Badge() {
									yes
								}
							} else {
								@badge.Badge(badge.Props{Variant: badge.VariantOutline}) {
									no
								}
							}
						</dd>
						<dt class="text-muted-foreground">Branches</dt>
						<dd class="font-mono text-xs">{ orAll(b.Branches) }</dd>
						<dt class="text-muted-foreground">Paths</dt>
						<dd class="font-mono text-xs">{ orAll(b.Paths) }</dd>
						<dt class="text-muted-foreground">Pipeline file</dt>
						<dd class="font-mono text-xs">{ orDefault(b.PipelineFile, ".ci.yml") }</dd>
						<dt class="text-muted-foreground">Check name</dt>
						<dd class="text-xs">{ orDefault(b.CheckName, "inherited") }</dd>
						<dt class="text-muted-foreground">Empty pipeline</dt>
						<dd class="text-xs">{ orDefault(b.OnEmptyPipeline, "skip") }</dd>
					</dl>
				}
			}
		</div>
		@card.Card() {
			@card.Header() {
				@card.Title() {
					Recent runs
				}
			}
			@card.Content(card.ContentProps{Class: "px-0"}) {
				if len(jobs) > 0 {
					@jobTable(jobs, false)
				} else {
					@empty.Empty(empty.Props{Class: "border-0 py-6"}) {
						@empty.Header() {
							@empty.Title() {
								Nothing yet
							}
						}
					}
				}
			}
		}
	}
}
