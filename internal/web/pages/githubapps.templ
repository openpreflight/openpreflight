package pages

import (
	"github.com/openpreflight/openpreflight/internal/store"
	"github.com/openpreflight/openpreflight/internal/web"
	"github.com/openpreflight/openpreflight/internal/web/components/badge"
	"github.com/openpreflight/openpreflight/internal/web/components/button"
	"github.com/openpreflight/openpreflight/internal/web/components/card"
	"github.com/openpreflight/openpreflight/internal/web/components/empty"
	"github.com/openpreflight/openpreflight/internal/web/components/field"
	"github.com/openpreflight/openpreflight/internal/web/components/icon"
	"github.com/openpreflight/openpreflight/internal/web/components/input"
	"github.com/openpreflight/openpreflight/internal/web/components/table"
	"github.com/openpreflight/openpreflight/internal/web/components/textarea"
	"github.com/openpreflight/openpreflight/internal/web/layouts"
)

templ GitHubApps(p web.Page) {
	{{ m := asMap(p.Data) }}
	{{ settings := settingsOf(m) }}
	{{ apps := appsOf(m) }}
	@layouts.Shell(p) {
		@layouts.PageHead("CI GitHub Apps", "Your own GitHub App is what makes this a CI provider: only an App can write commit checks, and each App has exactly one webhook URL. Coolify's deploy connector cannot do this job.") {
			@button.Button(button.Props{Href: "/github-apps/new", Size: button.SizeSm}) {
				Add an App
			}
		}
		if len(apps) > 0 {
			<div class="mb-8 grid gap-4">
				for _, app := range apps {
					@card.Card(card.Props{Size: card.SizeSm}) {
						@card.Header() {
							@card.Title(card.TitleProps{Class: "truncate"}) {
								{ app.Name }
							}
							@card.Description(card.DescriptionProps{Class: "font-mono text-xs"}) {
								{ appSubtitle(app) }
							}
							@card.Action() {
								@badge.Badge(badge.Props{
									Variant:    healthVariant(app.LastError, app.LastSeenAt != nil),
									Attributes: healthTitle(app.LastError),
								}) {
									{ healthLabel(app.LastError, app.LastSeenAt != nil) }
								}
							}
						}
						@card.Content(card.ContentProps{Class: "space-y-3"}) {
							<p class="text-muted-foreground text-xs">
								Writes a check named
								if app.CheckName != "" {
									<span class="text-foreground font-mono">{ app.CheckName }</span>
								} else {
									<span class="text-foreground font-mono">{ settings.DefaultCheckName }</span>
									<span>(global default)</span>
								}
							</p>
							@field.Field() {
								@field.Label(field.LabelProps{For: "hook-" + itoa64(app.ID)}) {
									Webhook URL
								}
								@input.Input(input.Props{
									ID:         "hook-" + itoa64(app.ID),
									Type:       "text",
									Class:      "font-mono text-xs",
									ReadOnly:   true,
									Value:      web.WebhookURL(settings.PublicBaseURL, app.Slug),
									Attributes: templ.Attributes{"aria-label": "Webhook URL for " + app.Name, "onfocus": "this.select()"},
								})
							}
							if p.Flash == "" && app.LastError != "" {
								@layouts.Toast(app.LastError, "err")
							}
							if app.LastError == "" && app.LastSeenAt != nil {
								<p class="text-muted-foreground text-xs">{ agoPtr(app.LastSeenAt) }</p>
							}
						}
						@card.Footer(card.FooterProps{Class: "flex flex-wrap gap-2"}) {
							<form method="post" action={ templ.SafeURL("/api/v1/github-apps/" + itoa64(app.ID) + "/test") } class="m-0">
								@layouts.CSRF(p.CSRFToken)
								@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantOutline, Size: button.SizeSm}) {
									Test
								}
							</form>
							@button.Button(button.Props{Href: "/github-apps/" + itoa64(app.ID) + "/edit", Variant: button.VariantOutline, Size: button.SizeSm}) {
								Edit
							}
							@button.Button(button.Props{Href: "/github-apps?inspect=" + itoa64(app.ID) + "#inspect", Variant: button.VariantGhost, Size: button.SizeSm}) {
								Installations
							}
							@layouts.Confirm(layouts.ConfirmProps{
								ID:          "del-app-" + itoa64(app.ID),
								Token:       p.CSRFToken,
								Action:      "/api/v1/github-apps/" + itoa64(app.ID) + "/delete",
								Trigger:     "Remove",
								Title:       "Remove this App?",
								Description: "Its repo bindings are removed too.",
							})
						}
					}
				}
			</div>
		} else {
			@empty.Empty(empty.Props{Class: emptyPageClass}) {
				@empty.Header() {
					@empty.Media(empty.MediaProps{Variant: empty.MediaVariantIcon}) {
						@icon.Github()
					}
					@empty.Title() {
						No CI GitHub App yet
					}
					@empty.Description() {
						Create with GitHub, or paste credentials under Advanced.
					}
				}
				@empty.Content() {
					@button.Button(button.Props{Href: "/github-apps/new", Size: button.SizeSm}) {
						Add an App
					}
				}
			}
		}
		if has(m, "Inspect") {
			{{ inspect := appOf(m, "Inspect") }}
			{{ installs := installsOf(m) }}
			{{ repos := ghReposOf(m) }}
			@card.Card(card.Props{ID: "inspect", Class: "mb-6 scroll-mt-6"}) {
				@card.Header() {
					@card.Title() {
						{ inspect.Name } - installations
					}
				}
				@card.Content(card.ContentProps{Class: "space-y-4"}) {
					@layouts.Toast(str(m, "InspectError"), "err")
					if len(installs) > 0 {
						@table.Table() {
							@table.Header() {
								@table.Row() {
									@table.Head() {
										Account
									}
									@table.Head() {
										Installation
									}
									@table.Head() {
										Repos
									}
								}
							}
							@table.Body() {
								for _, inst := range installs {
									@table.Row() {
										@table.Cell() {
											{ inst.Account.Login } <span class="text-muted-foreground text-xs">{ inst.Account.Type }</span>
										}
										@table.Cell(table.CellProps{Class: "font-mono text-xs"}) {
											{ itoa64(inst.ID) }
										}
										@table.Cell(table.CellProps{Class: "text-xs"}) {
											{ inst.RepositorySelection }
										}
									}
								}
							}
						}
					}
					if len(repos) > 0 {
						<h2 class="text-base font-semibold">Repositories visible to this App</h2>
						@table.Table() {
							@table.Header() {
								@table.Row() {
									@table.Head() {
										Repo
									}
									@table.Head() {
										Private
									}
								}
							}
							@table.Body() {
								for _, r := range repos {
									@table.Row() {
										@table.Cell(table.CellProps{Class: "font-mono text-xs"}) {
											{ r.FullName }
										}
										@table.Cell(table.CellProps{Class: "text-xs"}) {
											if r.Private {
												yes
											} else {
												no
											}
										}
									}
								}
							}
						}
						<p class="text-muted-foreground text-xs">
							Enable the ones you want checked on the
							<a class="text-primary underline-offset-4 hover:underline" href="/repos">Repos</a> page.
						</p>
					}
				}
			}
		}
	}
}

templ GitHubAppsEditorPage(p web.Page) {
	{{ m := asMap(p.Data) }}
	{{ settings := settingsOf(m) }}
	{{ editing := has(m, "Edit") }}
	{{ edit := appOf(m, "Edit") }}
	@layouts.Shell(p) {
		@layouts.PageHead(appFormTitle(editing, edit.Name), appFormLede(editing))
		@card.Card() {
			@card.Content() {
				if !editing {
					if settings.PublicBaseURL != "" {
						<div class="bg-muted/40 mb-6 rounded-lg border px-4 py-4">
							<p class="text-sm font-medium">Create the App on GitHub</p>
							<p class="text-muted-foreground mt-1 text-xs leading-relaxed">
								GitHub shows a review screen with the permissions this worker needs. We store the App it returns.
							</p>
							<form method="post" action="/api/v1/github-apps/manifest/start" class="mt-3">
								@layouts.CSRF(p.CSRFToken)
								@button.Button(button.Props{Type: button.TypeSubmit}) {
									Create with GitHub
								}
							</form>
						</div>
					} else {
						@layouts.Toast("Set the public base URL first. GitHub must be able to reach this host before creating an App.", "err")
						<p class="text-muted-foreground mb-6 text-sm">
							<a class="text-primary underline-offset-4 hover:underline" href="/settings">Open Settings</a>
						</p>
					}
					<details>
						<summary class="mb-4 cursor-pointer text-sm font-medium">Advanced: paste credentials</summary>
						<p class="text-muted-foreground mb-3 text-xs">
							Register the App on GitHub
							(<a class="text-primary underline-offset-4 hover:underline" href="https://github.com/settings/apps/new" target="_blank" rel="noreferrer">Settings → Developer settings → GitHub Apps</a>),
							then paste the credentials. GitHub Enterprise uses this path.
						</p>
						<p class="text-muted-foreground mb-4 text-xs">
							Permissions: <code class="font-mono">checks: write</code>, <code class="font-mono">contents: read</code>,
							<code class="font-mono">metadata: read</code>. Subscribe to <strong>Check suite</strong> and
							<strong>Check run</strong> events. Webhook URL:
							<code class="font-mono">
								{ webhookHint(settings.PublicBaseURL) }
							</code>
							- the slug below.
						</p>
						@appCredentialsForm(p, settings, editing, edit)
					</details>
				} else {
					@appCredentialsForm(p, settings, editing, edit)
				}
			}
		}
	}
}

templ appCredentialsForm(p web.Page, settings store.Settings, editing bool, edit store.GitHubApp) {
	<form method="post" action={ templ.SafeURL(appFormAction(editing, edit.ID)) } class="flex flex-col gap-4">
		@layouts.CSRF(p.CSRFToken)
		<div class="grid gap-4 sm:grid-cols-3">
			@field.Field() {
				@field.Label(field.LabelProps{For: "name"}) {
					Name
				}
				@input.Input(input.Props{ID: "name", Name: "name", Type: "text", Placeholder: "openpreflight-ci", Required: true, Value: edit.Name})
			}
			@field.Field() {
				@field.Label(field.LabelProps{For: "slug"}) {
					Slug (webhook path)
				}
				@input.Input(input.Props{ID: "slug", Name: "slug", Type: "text", Placeholder: "openpreflight-ci", Value: edit.Slug})
				@field.Description() {
					if editing {
						Changing the slug changes the webhook URL GitHub must post to.
					} else {
						Lowercase letters, digits, dashes. Defaults from the name.
					}
				}
			}
			@field.Field() {
				@field.Label(field.LabelProps{For: "app_id"}) {
					App ID
				}
				@input.Input(input.Props{ID: "app_id", Name: "app_id", Type: "number", Required: true, Value: appIDValue(editing, edit.AppID), Attributes: templ.Attributes{"min": "1"}})
			}
		</div>
		<div class="grid gap-4 sm:grid-cols-2">
			@field.Field() {
				@field.Label(field.LabelProps{For: "api_url"}) {
					API URL
				}
				@input.Input(input.Props{ID: "api_url", Name: "api_url", Type: "url", Value: apiURLValue(editing, edit.APIURL)})
				@field.Description() {
					Change only for GitHub Enterprise.
				}
			}
			@field.Field() {
				@field.Label(field.LabelProps{For: "check_name"}) {
					Check name for this App
				}
				@input.Input(input.Props{ID: "check_name", Name: "check_name", Type: "text", Placeholder: settings.DefaultCheckName, Value: edit.CheckName})
				@field.Description() {
					Optional. Blank uses the global default.
				}
			}
		</div>
		@field.Field() {
			@field.Label(field.LabelProps{For: "webhook_secret"}) {
				Webhook secret
			}
			@input.Input(input.Props{ID: "webhook_secret", Name: "webhook_secret", Type: "password", Required: !editing})
			@field.Description() {
				if editing {
					Leave blank to keep the stored secret.
				} else {
					Must match the secret set on the App. Use a different one per App.
				}
			}
		}
		@field.Field() {
			@field.Label(field.LabelProps{For: "pem"}) {
				Private key (PEM)
			}
			@textarea.Textarea(textarea.Props{
				ID:          "pem",
				Name:        "pem",
				Class:       "font-mono text-sm",
				Placeholder: "-----BEGIN RSA PRIVATE KEY-----",
				Attributes:  pemAttrs(editing),
			})
			@field.Description() {
				if editing {
					Leave blank to keep the stored key. Never displayed.
				} else {
					Stored encrypted with <code class="font-mono">CI_SECRET_KEY</code>. Never displayed again.
				}
			}
		}
		<div class="flex flex-wrap items-center gap-2">
			@button.Button(button.Props{Type: button.TypeSubmit, Size: button.SizeSm}) {
				if editing {
					Save
				} else {
					Add and test
				}
			}
			@button.Button(button.Props{Href: "/github-apps", Variant: button.VariantOutline, Size: button.SizeSm}) {
				Cancel
			}
		</div>
	</form>
}
