package pages

import (
	"github.com/openpreflight/openpreflight/internal/store"
	"github.com/openpreflight/openpreflight/internal/web"
	"github.com/openpreflight/openpreflight/internal/web/components/badge"
	"github.com/openpreflight/openpreflight/internal/web/components/button"
	"github.com/openpreflight/openpreflight/internal/web/components/card"
	"github.com/openpreflight/openpreflight/internal/web/components/empty"
	"github.com/openpreflight/openpreflight/internal/web/components/field"
	"github.com/openpreflight/openpreflight/internal/web/components/icon"
	"github.com/openpreflight/openpreflight/internal/web/components/input"
	"github.com/openpreflight/openpreflight/internal/web/components/table"
	"github.com/openpreflight/openpreflight/internal/web/components/textarea"
	"github.com/openpreflight/openpreflight/internal/web/layouts"
)

templ GitHubApps(p web.Page) {
	{{ m := asMap(p.Data) }}
	{{ settings := settingsOf(m) }}
	{{ apps := appsOf(m) }}
	@layouts.Shell(p) {
		@layouts.PageHead("CI GitHub Apps", "Your own GitHub App is what makes this a CI provider: only an App can write commit checks, and each App has exactly one webhook URL. Coolify's deploy connector cannot do this job.") {
			@button.Button(button.Props{Href: "/github-apps/new", Size: button.SizeSm}) {
				Add an App
			}
		}
		if len(apps) > 0 {
			<div class="mb-8 grid gap-4">
				for _, app := range apps {
					@card.Card(card.Props{Size: card.SizeSm}) {
						@card.Header() {
							@card.Title(card.TitleProps{Class: "truncate"}) {
								{ app.Name }
							}
							@card.Description(card.DescriptionProps{Class: "font-mono text-xs"}) {
								{ appSubtitle(app) }
							}
							@card.Action() {
								@badge.Badge(badge.Props{
									Variant:    healthVariant(app.LastError, app.LastSeenAt != nil),
									Attributes: healthTitle(app.LastError),
								}) {
									{ healthLabel(app.LastError, app.LastSeenAt != nil) }
								}
							}
						}
						@card.Content(card.ContentProps{Class: "space-y-3"}) {
							<p class="text-muted-foreground text-xs">
								Writes a check named
								if app.CheckName != "" {
									<span class="text-foreground font-mono">{ app.CheckName }</span>
								} else {
									<span class="text-foreground font-mono">{ settings.DefaultCheckName }</span>
									<span>(global default)</span>
								}
							</p>
							@field.Field() {
								@field.Label(field.LabelProps{For: "hook-" + itoa64(app.ID)}) {
									Webhook URL
								}
								@input.Input(input.Props{
									ID:         "hook-" + itoa64(app.ID),
									Type:       "text",
									Class:      "font-mono text-xs",
									ReadOnly:   true,
									Value:      web.WebhookURL(settings.PublicBaseURL, app.Slug),
									Attributes: templ.Attributes{"aria-label": "Webhook URL for " + app.Name, "onfocus": "this.select()"},
								})
							}
							if p.Flash == "" && app.LastError != "" {
								@layouts.Toast(app.LastError, "err")
							}
							if app.LastError == "" && app.LastSeenAt != nil {
								<p class="text-muted-foreground text-xs">{ agoPtr(app.LastSeenAt) }</p>
							}
						}
						@card.Footer(card.FooterProps{Class: "flex flex-wrap gap-2"}) {
							<form method="post" action={ templ.SafeURL("/api/v1/github-apps/" + itoa64(app.ID) + "/test") } class="m-0">
								@layouts.CSRF(p.CSRFToken)
								@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantOutline, Size: button.SizeSm}) {
									Test
								}
							</form>
							@button.Button(button.Props{Href: "/github-apps/" + itoa64(app.ID) + "/edit", Variant: button.VariantOutline, Size: button.SizeSm}) {
								Edit
							}
							@button.Button(button.Props{Href: "/github-apps?inspect=" + itoa64(app.ID) + "#inspect", Variant: button.VariantGhost, Size: button.SizeSm}) {
								Installations
							}
							@layouts.Confirm(layouts.ConfirmProps{
								ID:          "del-app-" + itoa64(app.ID),
								Token:       p.CSRFToken,
								Action:      "/api/v1/github-apps/" + itoa64(app.ID) + "/delete",
								Trigger:     "Remove",
								Title:       "Remove this App?",
								Description: "Its repo bindings are removed too.",
							})
						}
					}
				}
			</div>
		} else {
			@empty.Empty(empty.Props{Class: emptyPageClass}) {
				@empty.Header() {
					@empty.Media(empty.MediaProps{Variant: empty.MediaVariantIcon}) {
						@icon.Github()
					}
					@empty.Title() {
						No CI GitHub App yet
					}
					@empty.Description() {
						Let GitHub create one, or paste the credentials of an App you registered yourself.
					}
				}
				@empty.Content() {
					@button.Button(button.Props{Href: "/github-apps/new", Size: button.SizeSm}) {
						Add an App
					}
				}
			}
		}
		if has(m, "Inspect") {
			{{ inspect := appOf(m, "Inspect") }}
			{{ installs := installsOf(m) }}
			{{ repos := ghReposOf(m) }}
			@card.Card(card.Props{ID: "inspect", Class: "mb-6 scroll-mt-6"}) {
				@card.Header() {
					@card.Title() {
						{ inspect.Name } - installations
					}
				}
				@card.Content(card.ContentProps{Class: "space-y-4"}) {
					@layouts.Toast(str(m, "InspectError"), "err")
					if len(installs) > 0 {
						@table.Table() {
							@table.Header() {
								@table.Row() {
									@table.Head() {
										Account
									}
									@table.Head() {
										Installation
									}
									@table.Head() {
										Repos
									}
								}
							}
							@table.Body() {
								for _, inst := range installs {
									@table.Row() {
										@table.Cell() {
											{ inst.Account.Login } <span class="text-muted-foreground text-xs">{ inst.Account.Type }</span>
										}
										@table.Cell(table.CellProps{Class: "font-mono text-xs"}) {
											{ itoa64(inst.ID) }
										}
										@table.Cell(table.CellProps{Class: "text-xs"}) {
											{ inst.RepositorySelection }
										}
									}
								}
							}
						}
					}
					if len(repos) > 0 {
						<h2 class="text-base font-semibold">Repositories visible to this App</h2>
						@table.Table() {
							@table.Header() {
								@table.Row() {
									@table.Head() {
										Repo
									}
									@table.Head() {
										Private
									}
								}
							}
							@table.Body() {
								for _, r := range repos {
									@table.Row() {
										@table.Cell(table.CellProps{Class: "font-mono text-xs"}) {
											{ r.FullName }
										}
										@table.Cell(table.CellProps{Class: "text-xs"}) {
											if r.Private {
												yes
											} else {
												no
											}
										}
									}
								}
							}
						}
						<p class="text-muted-foreground text-xs">
							Enable the ones you want checked on the
							<a class="text-primary underline-offset-4 hover:underline" href="/repos">Repos</a> page.
						</p>
					}
				}
			}
		}
	}
}

templ GitHubAppsEditorPage(p web.Page) {
	{{ m := asMap(p.Data) }}
	{{ settings := settingsOf(m) }}
	{{ editing := has(m, "Edit") }}
	{{ edit := appOf(m, "Edit") }}
	@layouts.Shell(p) {
		@layouts.PageHead(appFormTitle(editing, edit.Name), appFormLede(editing))
		if !editing {
			// Two ways in, and they are not equal: the manifest flow fills in
			// every field below from GitHub's own response. Showing it as a
			// card and the paste form as a disclosure is the whole of the
			// recommendation — nothing here ranks them in prose.
			@appManifestCard(p, settings)
			<details class="group border-border hover:border-foreground/25 mb-8 rounded-xl border transition-colors open:border-border">
				<summary class="flex cursor-pointer list-none items-center gap-2.5 px-4 py-3.5 text-sm font-medium [&::-webkit-details-marker]:hidden">
					@icon.ChevronRight(icon.Props{Class: "size-4 shrink-0 text-muted-foreground transition-transform group-open:rotate-90"})
					<span>Paste credentials from an App you registered yourself</span>
					<span class="text-muted-foreground ml-auto text-xs font-normal">GitHub Enterprise</span>
				</summary>
				<div class="border-t px-4 pt-5 pb-5">
					@appManualHelp(settings)
					@appCredentialsForm(p, settings, editing, edit)
				</div>
			</details>
		} else {
			@card.Card() {
				@card.Content() {
					@appCredentialsForm(p, settings, editing, edit)
				}
			}
		}
	}
}

// appManifestCard is the recommended path. It needs a public base URL, because
// the manifest hands GitHub the webhook URL up front, so the unset case is a
// blocked action with the fix next to it rather than a form that fails later.
templ appManifestCard(p web.Page, settings store.Settings) {
	@card.Card(card.Props{Class: "mb-6"}) {
		@card.Header() {
			@card.Title() {
				Create the App on GitHub
			}
			@card.Description() {
				GitHub shows you a review screen with the permissions this worker needs, then hands the
				App back. Every field below is filled in for you, including the private key.
			}
			@card.Action() {
				@badge.Badge(badge.Props{Variant: badge.VariantSecondary}) {
					Recommended
				}
			}
		}
		@card.Content() {
			if settings.PublicBaseURL != "" {
				<dl class="grid gap-x-6 gap-y-3 text-sm sm:grid-cols-2">
					@appManifestFact("Webhook URL GitHub will be given") {
						<span class="font-mono text-xs break-all">{ webhookHint(settings.PublicBaseURL) }</span>
					}
					@appManifestFact("Permissions it will ask for") {
						<span class="font-mono text-xs">checks: write</span>,
						<span class="font-mono text-xs">contents: read</span>,
						<span class="font-mono text-xs">metadata: read</span>
					}
				</dl>
			} else {
				@layouts.Toast("Set the public base URL first. The manifest hands GitHub the webhook address at creation time, so this host has to have one before an App can be created.", "err")
			}
		}
		@card.Footer(card.FooterProps{Class: "flex flex-wrap items-center gap-2"}) {
			if settings.PublicBaseURL != "" {
				<form method="post" action="/api/v1/github-apps/manifest/start" class="m-0">
					@layouts.CSRF(p.CSRFToken)
					@button.Button(button.Props{Type: button.TypeSubmit, Size: button.SizeSm}) {
						Create with GitHub
					}
				</form>
			} else {
				@button.Button(button.Props{Href: "/settings", Size: button.SizeSm}) {
					Set the public base URL
				}
			}
		}
	}
}

templ appManifestFact(label string) {
	<div class="min-w-0">
		<dt class="text-muted-foreground text-xs">{ label }</dt>
		<dd class="mt-0.5 min-w-0">
			{ children... }
		</dd>
	</div>
}

templ appManualHelp(settings store.Settings) {
	<ol class="text-muted-foreground mb-5 space-y-1.5 text-xs leading-relaxed">
		<li>
			1. Register the App at
			<a class="text-primary underline-offset-4 hover:underline" href="https://github.com/settings/apps/new" target="_blank" rel="noreferrer">Settings → Developer settings → GitHub Apps</a>.
		</li>
		<li>
			2. Permissions: <code class="text-foreground font-mono">checks: write</code>,
			<code class="text-foreground font-mono">contents: read</code>,
			<code class="text-foreground font-mono">metadata: read</code>. Subscribe to
			<strong class="text-foreground">Check suite</strong> and <strong class="text-foreground">Check run</strong>.
		</li>
		<li>
			3. Webhook URL: <code class="text-foreground font-mono break-all">{ webhookHint(settings.PublicBaseURL) }</code>,
			where the slug is the one you enter below.
		</li>
		<li>4. Generate a private key, then paste the App ID, the webhook secret and the PEM here.</li>
	</ol>
}

templ appCredentialsForm(p web.Page, settings store.Settings, editing bool, edit store.GitHubApp) {
	<form method="post" action={ templ.SafeURL(appFormAction(editing, edit.ID)) } class="flex flex-col gap-8">
		@layouts.CSRF(p.CSRFToken)
		@formSection("Identity", "The name is yours; the slug is GitHub's half of the webhook URL.") {
			<div class="grid gap-4 sm:grid-cols-2">
				@field.Field() {
					@field.Label(field.LabelProps{For: "name"}) {
						Name
					}
					@input.Input(input.Props{
						ID: "name", Name: "name", Type: "text", Placeholder: "openpreflight-ci",
						Required: true, Value: edit.Name, Attributes: noAutofill,
					})
					@field.Description() {
						Shown on this page and nowhere on GitHub.
					}
				}
				@field.Field() {
					@field.Label(field.LabelProps{For: "slug"}) {
						Slug
					}
					@input.Input(input.Props{
						ID: "slug", Name: "slug", Type: "text", Class: "font-mono",
						Placeholder: "openpreflight-ci", Value: edit.Slug, Attributes: slugAttrs,
					})
					@field.Description() {
						if editing {
							The webhook URL ends in this. Changing it breaks deliveries until you change the App on GitHub to match.
						} else {
							Lowercase letters, digits and dashes. Defaults from the name.
						}
					}
				}
			</div>
		}
		@formSection("Where it talks to", "") {
			<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
				@field.Field() {
					@field.Label(field.LabelProps{For: "app_id"}) {
						App ID
					}
					@input.Input(input.Props{
						ID: "app_id", Name: "app_id", Type: "number", Required: true,
						Value:      appIDValue(editing, edit.AppID),
						Attributes: templ.Attributes{"min": "1", "autocomplete": "off", "inputmode": "numeric"},
					})
					@field.Description() {
						The number on the App's settings page.
					}
				}
				@field.Field() {
					@field.Label(field.LabelProps{For: "api_url"}) {
						API URL
					}
					@input.Input(input.Props{
						ID: "api_url", Name: "api_url", Type: "url", Class: "font-mono text-xs",
						Value: apiURLValue(editing, edit.APIURL), Attributes: noAutofill,
					})
					@field.Description() {
						Change only for GitHub Enterprise.
					}
				}
				@field.Field() {
					@field.Label(field.LabelProps{For: "check_name"}) {
						Check name
					}
					@input.Input(input.Props{
						ID: "check_name", Name: "check_name", Type: "text",
						Placeholder: settings.DefaultCheckName, Value: edit.CheckName, Attributes: noAutofill,
					})
					@field.Description() {
						Blank uses the global default.
					}
				}
			</div>
		}
		@formSection("Credentials", "Both are stored encrypted with CI_SECRET_KEY and are never displayed again.") {
			@field.Field() {
				@field.Label(field.LabelProps{For: "webhook_secret"}) {
					Webhook secret
				}
				@input.Input(input.Props{
					ID: "webhook_secret", Name: "webhook_secret", Type: "password",
					Required: !editing, Attributes: secretAttrs,
				})
				@field.Description() {
					if editing {
						Leave blank to keep the stored secret.
					} else {
						Must match the secret set on the App. Use a different one per App.
					}
				}
			}
			@field.Field() {
				@field.Label(field.LabelProps{For: "pem"}) {
					Private key (PEM)
				}
				@textarea.Textarea(textarea.Props{
					ID:          "pem",
					Name:        "pem",
					Class:       "min-h-40 font-mono text-xs",
					// Deliberately only the opening line: the whole-page leak
					// check greps for the END marker, and a placeholder carrying
					// one would blind that check for good.
					Placeholder: "-----BEGIN RSA PRIVATE KEY-----",
					Attributes:  pemAttrs(editing),
				})
				@field.Description() {
					if editing {
						Leave blank to keep the stored key.
					} else {
						The whole file GitHub downloaded, including the BEGIN and END lines.
					}
				}
			}
		}
		@formActions() {
			@button.Button(button.Props{Type: button.TypeSubmit, Size: button.SizeSm}) {
				if editing {
					Save changes
				} else {
					Add and test
				}
			}
			@button.Button(button.Props{Href: "/github-apps", Variant: button.VariantOutline, Size: button.SizeSm}) {
				Cancel
			}
			if !editing {
				<span class="text-muted-foreground text-xs">Saving calls GitHub once to check the credentials work.</span>
			}
		}
	</form>
}

// formActions is the footer every editor form ends with: a rule, then the
// buttons. Separate so the two editors cannot drift apart.
templ formActions() {
	<div class="flex flex-wrap items-center gap-x-3 gap-y-2 border-t pt-5">
		{ children... }
	</div>
}
