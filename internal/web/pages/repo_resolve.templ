package pages

import (
	"github.com/openpreflight/openpreflight/internal/pipeline"
	"github.com/openpreflight/openpreflight/internal/web"
	"github.com/openpreflight/openpreflight/internal/web/components/button"
	"github.com/openpreflight/openpreflight/internal/web/components/empty"
	"github.com/openpreflight/openpreflight/internal/web/components/icon"
	"github.com/openpreflight/openpreflight/internal/web/components/input"
	"github.com/openpreflight/openpreflight/internal/web/layouts"
)

// RepoResolve is the dry run: what this repository would do on a ref, and which
// configuration layer decided each part of it.
//
// The question it answers — "why did it run *that*?" — previously had only one
// way to be answered, which was to push a commit and read the log afterwards.
templ RepoResolve(p web.Page) {
	{{ m := asMap(p.Data) }}
	{{ b := bindingKeyOf(m, "Binding") }}
	{{ res := resolutionOf(m) }}
	{{ failure := str(m, "Error") }}
	@layouts.Shell(p) {
		@layouts.PageHead("Dry run", resolveLede(b.Repo)) {
			@button.Button(button.Props{Href: "/repos/" + itoa64(b.ID), Variant: button.VariantOutline, Size: button.SizeSm}) {
				Back to repo
			}
		}
		<form method="get" action={ templ.SafeURL("/repos/" + itoa64(b.ID) + "/resolve") }>
			@layouts.ListCard() {
				<div>
					@fieldRow("ref", "Branch, tag or commit", "Resolved exactly as a webhook for it would be. Blank uses the default branch.") {
						<div class="flex gap-2">
							@input.Input(input.Props{ID: "ref", Name: "ref", Type: "text", Class: "font-mono", Value: str(m, "Ref"), Placeholder: "the default branch", Attributes: noAutofill})
							@button.Button(button.Props{Type: button.TypeSubmit, Size: button.SizeSm, Class: "h-8"}) {
								Resolve
							}
						</div>
					}
				</div>
			}
		</form>
		if failure != "" {
			@layouts.Notice(layouts.ToneDanger, "The dry run could not be attempted", failure)
		} else {
			@layouts.ListCard() {
				@layouts.ListHead(resolveVerdict(res), -1, res.Explanation) {
					@layouts.Status(resolveWord(res), resolveTone(res))
				}
				<div class="p-4">
					@detailList() {
						@detailRow("Commit") {
							<span class="font-mono">{ web.ShortSHA(res.SHA) }</span> on <span class="font-mono">{ res.Ref }</span>
						}
						@detailRow("Check name") {
							{ res.CheckName }
						}
						@detailRow("Executor") {
							<span class="font-mono">{ res.Executor }</span>
						}
						@detailRow("Timeout") {
							{ res.Timeout }
						}
					}
				</div>
			}
			if len(res.Errors) > 0 || len(res.Warnings) > 0 {
				<div class="mb-6 space-y-3">
					for _, msg := range res.Errors {
						@layouts.Notice(layouts.ToneDanger, "", msg)
					}
					for _, msg := range res.Warnings {
						@layouts.Notice(layouts.ToneWarning, "", msg)
					}
				</div>
			}
			@layouts.ListCard() {
				@layouts.ListHead("Steps", len(res.Steps), "Each command, with the configuration layer that supplied it.")
				if len(res.Steps) > 0 {
					@layouts.List() {
						for _, step := range res.Steps {
							<li class="grid grid-cols-[minmax(0,1fr)_auto] items-start gap-x-4 px-4 py-2.5">
								<div class="min-w-0">
									<p class="text-sm font-medium">{ step.Name }</p>
									<code class="text-muted-foreground mt-0.5 block truncate font-mono text-xs" title={ step.Command }>{ step.Command }</code>
								</div>
								<span class="text-muted-foreground pt-0.5 text-xs">{ step.Source }</span>
							</li>
						}
					}
				} else {
					@empty.Empty(empty.Props{Class: emptyInCardClass}) {
						@empty.Header() {
							@empty.Media(empty.MediaProps{Variant: empty.MediaVariantIcon}) {
								@icon.ListX()
							}
							@empty.Title() {
								No steps
							}
							@empty.Description() {
								Nothing resolved to a command, so this commit would run nothing. The repo's "When there is nothing to run" setting decides whether that is a skip or a failure.
							}
						}
					}
				}
			}
			@layouts.ListCard() {
				@layouts.ListHead("Where every value came from", -1, "The four layers, in the order they are checked: the pipeline file in the commit, then the repo, then settings, then a built-in default.")
				@originsTable(res.Origins)
			}
			if res.PathFilter != "" {
				@layouts.ListCard() {
					@layouts.ListHead("Path filter", -1, "Evaluated against the same commit a webhook would deliver.")
					<pre class="overflow-x-auto p-4 font-mono text-xs">{ res.PathFilter }</pre>
				}
			}
		}
	}
}

// resolveVerdict is the headline: the one thing an operator came to read.
func resolveVerdict(res pipeline.Resolution) string {
	switch res.Decision {
	case pipeline.DecisionSkip:
		return "This commit would be skipped"
	case pipeline.DecisionFail:
		return "This commit would fail"
	default:
		return "This commit would run"
	}
}

func resolveLede(repo string) string {
	return "What " + repo + " would do, resolved against a real commit. Nothing is queued and no Check Run is written."
}

func resolveTone(res pipeline.Resolution) layouts.Tone {
	switch res.Decision {
	case pipeline.DecisionSkip:
		return layouts.ToneNeutral
	case pipeline.DecisionFail:
		return layouts.ToneDanger
	}
	return layouts.ToneSuccess
}

func resolveWord(res pipeline.Resolution) string {
	if res.Decision == pipeline.DecisionSkip || res.Decision == pipeline.DecisionFail {
		return "would " + res.Decision
	}
	return "would run"
}
