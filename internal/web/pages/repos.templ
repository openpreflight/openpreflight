package pages

import (
	"github.com/openpreflight/openpreflight/internal/web"
	"github.com/openpreflight/openpreflight/internal/web/components/button"
	"github.com/openpreflight/openpreflight/internal/web/components/checkbox"
	"github.com/openpreflight/openpreflight/internal/web/components/empty"
	"github.com/openpreflight/openpreflight/internal/web/components/icon"
	"github.com/openpreflight/openpreflight/internal/web/components/input"
	selectcomp "github.com/openpreflight/openpreflight/internal/web/components/select"
	"github.com/openpreflight/openpreflight/internal/web/layouts"
)

templ Repos(p web.Page) {
	@layouts.Shell(p) {
		@reposList(p)
	}
}

templ ReposPick(p web.Page) {
	{{ m := asMap(p.Data) }}
	{{ apps := appsOf(m) }}
	@layouts.Shell(p) {
		@layouts.PageHead("Pick repositories", "Choose an App, then check the repositories this worker should run.")
		if len(apps) == 0 {
			@reposNeedApp()
		} else {
			@reposApps(p)
		}
	}
}

templ ReposEditorPage(p web.Page) {
	{{ m := asMap(p.Data) }}
	{{ apps := appsOf(m) }}
	{{ editing := has(m, "Edit") }}
	@layouts.Shell(p) {
		@layouts.PageHead(bindingFormTitle(editing, bindingOf(m).Repo), bindingFormLede(editing)) {
			if !editing && len(apps) > 0 {
				@button.Button(button.Props{Href: "/repos/pick", Variant: button.VariantOutline, Size: button.SizeSm}) {
					Pick from an App instead
				}
			}
		}
		if len(apps) == 0 {
			@reposNeedApp()
		} else {
			@reposEditor(p)
		}
	}
}

templ reposList(p web.Page) {
	{{ m := asMap(p.Data) }}
	{{ apps := appsOf(m) }}
	{{ rows := rowsOf(m) }}
	@layouts.PageHead("Repos", "The repositories this worker checks. Each is bound to the GitHub App that receives its webhooks.") {
		if len(apps) > 0 {
			@button.Button(button.Props{Href: "/repos/pick", Size: button.SizeSm}) {
				Pick repositories
			}
			@button.Button(button.Props{Href: "/repos/new", Variant: button.VariantOutline, Size: button.SizeSm}) {
				Add a repository
			}
		}
	}
	if len(rows) > 0 {
		@layouts.ListCard() {
			@layouts.ListHead("Bindings", len(rows), "A repo with no enabled binding is ignored, even if its webhook signature is valid.")
			@layouts.List() {
				for _, row := range rows {
					@bindingRowItem(p, row)
				}
			}
		}
	} else if len(apps) == 0 {
		@reposNeedApp()
	} else {
		@empty.Empty(empty.Props{Class: emptyPageClass}) {
			@empty.Header() {
				@empty.Media(empty.MediaProps{Variant: empty.MediaVariantIcon}) {
					@icon.FolderGit()
				}
				@empty.Title() {
					No bindings yet
				}
				@empty.Description() {
					Pick repositories from an App, or add a binding by owner/name.
				}
			}
			@empty.Content() {
				@button.Button(button.Props{Href: "/repos/pick", Size: button.SizeSm}) {
					Pick repositories
				}
				@button.Button(button.Props{Href: "/repos/new", Variant: button.VariantOutline, Size: button.SizeSm}) {
					Add a repository
				}
			}
		}
	}
	if len(rows) > 0 && len(apps) == 0 {
		@reposNeedApp()
	}
}

// bindingRowItem is one binding: the repo, whether it runs, what it is filtered
// to, and what happened last. The row opens the repo's page; the two controls
// that change state stay on the row.
templ bindingRowItem(p web.Page, row bindingRow) {
	{{ filter := bindingFilterLine(row) }}
	<li class="relative grid grid-cols-1 items-center gap-x-4 gap-y-2 px-4 py-3 transition-colors hover:bg-muted/40 md:grid-cols-[minmax(0,1fr)_minmax(0,16rem)_auto]">
		<div class="min-w-0">
			<div class="flex min-w-0 items-center gap-2">
				<a class="row-link truncate text-sm font-medium" href={ templ.SafeURL("/repos/" + itoa64(row.Binding.ID)) } title={ row.Binding.Repo }>{ row.Binding.Repo }</a>
				@bindingStatus(row.Binding.Enabled)
				if row.Binding.ShareableLogs {
					@layouts.Status("public logs", layouts.ToneWarning)
				}
			</div>
			<p class="text-muted-foreground mt-0.5 truncate text-xs" title={ filter }>{ filter }</p>
		</div>
		<div class="min-w-0">
			if row.LastJob.ID != "" {
				<div class="flex min-w-0 items-center gap-2">
					@StatusBadge(row.LastJob)
					<span class="text-muted-foreground truncate text-xs">{ jobRefLabel(row.LastJob) } · { web.Ago(row.LastJob.CreatedAt) }</span>
				</div>
			} else {
				<span class="text-muted-foreground text-xs">no runs yet</span>
			}
		</div>
		<div class="relative z-10 flex items-center gap-1 md:justify-end">
			<form method="post" action={ templ.SafeURL("/api/v1/bindings/" + itoa64(row.Binding.ID) + "/toggle") } class="m-0">
				@layouts.CSRF(p.CSRFToken)
				@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantOutline, Size: button.SizeSm}) {
					if row.Binding.Enabled {
						Disable
					} else {
						Enable
					}
				}
			</form>
			@layouts.RowMenu("bind-menu-"+itoa64(row.Binding.ID), "More actions for "+row.Binding.Repo) {
				<a role="menuitem" class={ layouts.MenuItemClass } href={ templ.SafeURL("/repos/" + itoa64(row.Binding.ID) + "/edit") }>
					@icon.Settings()
					Edit
				</a>
				<a role="menuitem" class={ layouts.MenuItemClass } href={ templ.SafeURL("/repos/" + itoa64(row.Binding.ID) + "/resolve") }>
					@icon.Search()
					Dry run
				</a>
				<a role="menuitem" class={ layouts.MenuItemClass } href={ templ.SafeURL("/jobs?repo=" + row.Binding.Repo) }>
					@icon.Workflow()
					All runs
				</a>
				<a role="menuitem" class={ layouts.MenuItemClass } href={ templ.SafeURL("https://github.com/" + row.Binding.Repo) } target="_blank" rel="noopener">
					@icon.ExternalLink()
					Open on GitHub
				</a>
				@layouts.MenuSeparator()
				@layouts.Confirm(layouts.ConfirmProps{
					ID:          "del-bind-" + itoa64(row.Binding.ID),
					Token:       p.CSRFToken,
					Action:      "/api/v1/bindings/" + itoa64(row.Binding.ID) + "/delete",
					Trigger:     "Remove",
					MenuItem:    true,
					Title:       "Remove " + row.Binding.Repo + "?",
					Description: "The repo stops being checked. Its past runs stay in Jobs.",
				})
			}
		</div>
	</li>
}

templ bindingStatus(on bool) {
	if on {
		@layouts.Status("enabled", layouts.ToneSuccess)
	} else {
		@layouts.Status("disabled", layouts.ToneNeutral)
	}
}

templ reposNeedApp() {
	@empty.Empty(empty.Props{Class: emptyPageClass}) {
		@empty.Header() {
			@empty.Media(empty.MediaProps{Variant: empty.MediaVariantIcon}) {
				@icon.Github()
			}
			@empty.Title() {
				Add a CI GitHub App first
			}
			@empty.Description() {
				A binding needs an App: it verifies the webhook signature and writes the Check Run.
			}
		}
		@empty.Content() {
			@button.Button(button.Props{Href: "/github-apps/new", Size: button.SizeSm}) {
				Add one
			}
		}
	}
}

templ reposApps(p web.Page) {
	{{ m := asMap(p.Data) }}
	{{ apps := appsOf(m) }}
	{{ instances := instancesOf(m) }}
	{{ selectedApp := asInt64(m, "SelectedAppID") }}
	{{ selectedCoolify := asInt64(m, "SelectedCoolifyID") }}
	{{ picker := pickerOf(m) }}
	// onchange sits on the form, not on each select: the component submits
	// its value through a hidden input whose change event bubbles, so picking
	// a source reloads the list without a second click.
	<form method="get" action="/repos/pick" onchange="this.submit()">
		@layouts.ListCard() {
			@layouts.ListHead("Source", -1, "The App must be installed on every repository you pick: it receives the webhooks, writes the checks and clones the code.")
			<div class="divide-y">
				@fieldRow("app_id", "GitHub App", "Repositories come from this App's installations.") {
					@selectcomp.Select(selectcomp.Props{ID: "app_id-list", Name: "app_id", DefaultValue: idValue(selectedApp)}) {
						@selectcomp.Trigger(selectcomp.TriggerProps{ID: "app_id", Class: "w-full"}) {
							@selectcomp.Value(selectcomp.ValueProps{Placeholder: "Choose an App"})
						}
						@selectcomp.Content(selectcomp.ContentProps{DisableAlignItemWithTrigger: true, Align: selectcomp.AlignStart}) {
							for _, a := range apps {
								@selectcomp.Item(selectcomp.ItemProps{Value: itoa64(a.ID)}) {
									{ a.Name }
								}
							}
						}
					}
				}
				if len(instances) > 0 {
					@fieldRow("coolify_id", "Repo list from", "Optional. A Coolify connector's list is inventory only; the App above still does the webhook, the check and the clone.") {
						@selectcomp.Select(selectcomp.Props{ID: "coolify_id-list", Name: "coolify_id", DefaultValue: idValue(selectedCoolify)}) {
							@selectcomp.Trigger(selectcomp.TriggerProps{ID: "coolify_id", Class: "w-full"}) {
								@selectcomp.Value(selectcomp.ValueProps{Placeholder: appInstallationsLabel})
							}
							@selectcomp.Content(selectcomp.ContentProps{DisableAlignItemWithTrigger: true, Align: selectcomp.AlignStart}) {
								@selectcomp.Item(selectcomp.ItemProps{Value: ""}) {
									{ appInstallationsLabel }
								}
								for _, inst := range instances {
									@selectcomp.Item(selectcomp.ItemProps{Value: itoa64(inst.ID)}) {
										Coolify: { inst.Name }
									}
								}
							}
						}
					}
				}
			</div>
			// Without script the selects still post; this is their submit.
			<noscript>
				<div class="bg-muted/30 flex justify-end border-t px-4 py-3">
					@button.Button(button.Props{Type: button.TypeSubmit, Size: button.SizeSm, Variant: button.VariantSecondary}) {
						Load repositories
					}
				</div>
			</noscript>
		}
	</form>
	if pickerError(m) != "" {
		<div class="mb-6">
			@layouts.Notice(layouts.ToneDanger, "Could not load repositories", pickerError(m))
		</div>
	}
	if len(picker) > 0 {
		<form method="post" action="/api/v1/bindings/bulk">
			@layouts.CSRF(p.CSRFToken)
			<input type="hidden" name="github_app_id" value={ itoa64(selectedApp) }/>
			<input type="hidden" name="coolify_instance_id" value={ itoa64(selectedCoolify) }/>
			@layouts.ListCard() {
				@layouts.ListHead("Repositories", len(picker), "Checked repositories get a binding. Unchecking one removes its binding. A pipeline runs the repository's own commands on this host, so pick only code you trust.")
				@layouts.List() {
					for _, r := range picker {
						<li>
							<label for={ "repo-" + r.FullName } class="hover:bg-muted/40 flex cursor-pointer items-center gap-3 px-4 py-2.5 transition-colors">
								@checkbox.Checkbox(checkbox.Props{
									ID:             "repo-" + r.FullName,
									Name:           "repo",
									Value:          r.FullName,
									DefaultChecked: r.Bound,
								})
								@layouts.GitHubMark("text-muted-foreground size-4 shrink-0")
								<span class="min-w-0 flex-1 truncate font-mono text-sm" title={ r.FullName }>{ r.FullName }</span>
								if r.Private {
									@layouts.Status("private", layouts.ToneNeutral)
								}
								if r.Bound {
									@layouts.Status("bound", layouts.ToneSuccess)
								}
							</label>
						</li>
					}
				}
			}
			@formBar() {
				<div class="ml-auto flex gap-2">
					@button.Button(button.Props{Href: "/repos", Variant: button.VariantOutline, Size: button.SizeSm}) {
						Cancel
					}
					@button.Button(button.Props{Type: button.TypeSubmit, Size: button.SizeSm}) {
						Save selection
					}
				</div>
			}
		</form>
	} else if selectedApp != 0 && pickerError(m) == "" {
		@layouts.ListCard() {
			@empty.Empty(empty.Props{Class: emptyInCardClass}) {
				@empty.Header() {
					@empty.Media(empty.MediaProps{Variant: empty.MediaVariantIcon}) {
						@icon.FolderGit()
					}
					@empty.Title() {
						No repositories on this source
					}
					@empty.Description() {
						Install the App on a GitHub account or organization, or pick a Coolify connector that has repositories, then choose the App again.
					}
				}
			}
		}
	}
}

templ reposEditor(p web.Page) {
	@reposEditorForm(p)
}

templ reposEditorForm(p web.Page) {
	{{ m := asMap(p.Data) }}
	{{ settings := settingsOf(m) }}
	{{ apps := appsOf(m) }}
	{{ instances := instancesOf(m) }}
	{{ editing := has(m, "Edit") }}
	{{ edit := bindingOf(m) }}
	// A binding answers four questions in order: which repo, when to run it,
	// who may read the output, and (rarely) what to override. Each is a panel
	// of label-left, control-right rows, so the eye runs down one column of
	// labels instead of across three columns of boxes.
	<form method="post" action="/api/v1/bindings">
		@layouts.CSRF(p.CSRFToken)
		@layouts.ListCard() {
			@layouts.ListHead("Repository", -1, "Which repository, and which App receives its webhooks and writes its checks.")
			<div class="divide-y">
				@fieldRow("b_repo", "Repository", repoHint(editing)) {
					<div class={ "border-input flex h-8 w-full min-w-0 items-center overflow-hidden rounded-lg border focus-within:border-ring focus-within:ring-3 focus-within:ring-ring/50", templ.KV("bg-muted/50", editing) }>
						<span class="text-muted-foreground bg-muted/60 flex h-full shrink-0 items-center gap-1.5 border-r px-2.5 text-xs">
							@layouts.GitHubMark("size-3.5")
							github.com/
						</span>
						<input id="b_repo" name="repo" type="text" required placeholder="owner/name" value={ edit.Repo } readonly?={ editing } class="placeholder:text-muted-foreground/55 h-full min-w-0 flex-1 bg-transparent px-2.5 font-mono text-sm outline-none" { noAutofill... }/>
					</div>
				}
				@fieldRow("b_app", "GitHub App", "Verifies the webhook signature and writes the Check Run. The App must be installed on this repository.") {
					// Submits only what is selected, so the first App is the explicit
					// default on a new binding rather than an accident of order.
					@selectcomp.Select(selectcomp.Props{ID: "b_app-list", Name: "github_app_id", Required: true, DefaultValue: editAppValue(editing, edit.GitHubAppID, apps)}) {
						@selectcomp.Trigger(selectcomp.TriggerProps{ID: "b_app", Class: "w-full"}) {
							@selectcomp.Value(selectcomp.ValueProps{Placeholder: firstAppName(apps)})
						}
						@selectcomp.Content(selectcomp.ContentProps{DisableAlignItemWithTrigger: true, Align: selectcomp.AlignStart}) {
							for _, a := range apps {
								@selectcomp.Item(selectcomp.ItemProps{Value: itoa64(a.ID)}) {
									{ a.Name }
								}
							}
						}
					}
				}
				if len(instances) > 0 {
					@fieldRow("b_coolify", "Coolify instance", "Optional. Bookkeeping only: Coolify never runs or reports the job.") {
						@selectcomp.Select(selectcomp.Props{ID: "b_coolify-list", Name: "coolify_instance_id", DefaultValue: editInstValue(editing, edit.CoolifyInstanceID)}) {
							@selectcomp.Trigger(selectcomp.TriggerProps{ID: "b_coolify", Class: "w-full"}) {
								@selectcomp.Value(selectcomp.ValueProps{Placeholder: "None"})
							}
							@selectcomp.Content(selectcomp.ContentProps{DisableAlignItemWithTrigger: true, Align: selectcomp.AlignStart}) {
								@selectcomp.Item(selectcomp.ItemProps{Value: "0"}) {
									None
								}
								for _, inst := range instances {
									@selectcomp.Item(selectcomp.ItemProps{Value: itoa64(inst.ID)}) {
										{ inst.Name }
									}
								}
							}
						}
					}
				} else {
					<input type="hidden" name="coolify_instance_id" value={ editInstValue(editing, edit.CoolifyInstanceID) }/>
				}
			</div>
		}
		@layouts.ListCard() {
			@layouts.ListHead("When to run", -1, "Leave both filters empty to check every push to every branch.")
			<div class="divide-y">
				@fieldRow("b_branches", "Branches", "Comma-separated globs. Empty allows every branch.") {
					@input.Input(input.Props{
						ID: "b_branches", Name: "branches", Type: "text", Class: "font-mono",
						Placeholder: branchesPlaceholder, Value: edit.Branches, Attributes: noAutofill,
					})
				}
				@fieldRow("b_paths", "Paths", "Comma-separated globs. A commit that touches none of them is reported as skipped.") {
					@input.Input(input.Props{
						ID: "b_paths", Name: "paths", Type: "text", Class: "font-mono",
						Placeholder: "frontend/**, packages/api/**", Value: edit.Paths, Attributes: noAutofill,
					})
				}
				@fieldRow("b_on_empty", "When there is nothing to run", "No pipeline file, no commands and no recognisable project. Usually a misconfiguration.") {
					@selectcomp.Select(selectcomp.Props{ID: "b_on_empty-list", Name: "on_empty_pipeline", DefaultValue: onEmptyValue(edit.OnEmptyPipeline)}) {
						@selectcomp.Trigger(selectcomp.TriggerProps{ID: "b_on_empty", Class: "w-full"}) {
							@selectcomp.Value(selectcomp.ValueProps{Placeholder: "Skip the job"})
						}
						@selectcomp.Content(selectcomp.ContentProps{DisableAlignItemWithTrigger: true, Align: selectcomp.AlignStart}) {
							@selectcomp.Item(selectcomp.ItemProps{Value: "skip"}) {
								Skip the job
							}
							@selectcomp.Item(selectcomp.ItemProps{Value: "fail"}) {
								Fail the job
							}
						}
					}
				}
			</div>
		}
		@layouts.ListCard() {
			@layouts.ListHead("Access", -1, "")
			<div class="divide-y">
				@switchRow("b_enabled", "enabled", "Enabled", "Off means webhooks for this repo are dropped, even with a valid signature.", bindingEnabledChecked(editing, edit.Enabled), false)
				@switchRow("b_shareable", "shareable_logs", "Public build logs", "Anyone holding a run's /runs/{id} link can read its full output without signing in. Run ids are random, but treat the link as a secret.", shareableChecked(editing, edit.ShareableLogs), true)
			</div>
		}
		// Rarely needed, so folded: every one of these inherits a sensible
		// default. Open when editing a binding that already overrides one.
		<details data-slot="list-card" class="group bg-muted/60 text-card-foreground mb-6 rounded-xl border p-1" open?={ bindingOverrides(edit) }>
			<summary data-slot="list-head" class="flex cursor-pointer list-none items-center gap-2 px-3 pt-2 pb-2.5 [&::-webkit-details-marker]:hidden">
				@icon.ChevronRight(icon.Props{Class: "text-muted-foreground size-4 transition-transform group-open:rotate-90"})
				<div class="min-w-0">
					<h2 class="text-sm font-semibold">
						Overrides
						if n := bindingOverrideCount(edit); n > 0 {
							<span class="text-muted-foreground ml-1 font-normal">{ itoa(n) } set</span>
						}
					</h2>
					<p class="text-muted-foreground mt-0.5 text-xs">Check name, pipeline file, timeout and fallback commands. Blank inherits the worker's defaults.</p>
				</div>
			</summary>
			<div class="divide-y">
				@fieldRow("b_check", "Check name", "What GitHub shows next to the commit. Blank uses "+settings.DefaultCheckName+".") {
					@input.Input(input.Props{
						ID: "b_check", Name: "check_name", Type: "text",
						Placeholder: settings.DefaultCheckName, Value: edit.CheckName, Attributes: noAutofill,
					})
				}
				@fieldRow("b_file", "Pipeline file", "Read from the commit being checked. Blank uses "+settings.DefaultPipelineFile+".") {
					@input.Input(input.Props{
						ID: "b_file", Name: "pipeline_file", Type: "text", Class: "font-mono",
						Placeholder: settings.DefaultPipelineFile, Value: edit.PipelineFile, Attributes: noAutofill,
					})
				}
				@fieldRow("b_timeout", "Timeout", "In seconds. 0 or blank uses the default of "+secondsLabel(settings.DefaultTimeoutSeconds)+".") {
					@unitInput("seconds") {
						@input.Input(input.Props{
							ID: "b_timeout", Name: "timeout_seconds", Type: "number", Class: "w-32",
							Placeholder: itoa(settings.DefaultTimeoutSeconds), Value: timeoutVal(edit.TimeoutSeconds),
							Attributes: templ.Attributes{"min": "0", "autocomplete": "off", "inputmode": "numeric"},
						})
					}
				}
				@fieldRow("b_install", "Fallback commands", "Run only when the commit has no pipeline file. Blank infers them from the project, such as a Node package.json.") {
					<div class="grid gap-2">
						for _, c := range []struct{ id, name, label, ph, val string }{
							{"b_install", "install_cmd", "install", "npm ci", edit.InstallCmd},
							{"b_test", "test_cmd", "test", "npm test", edit.TestCmd},
							{"b_build", "build_cmd", "build", "npm run build", edit.BuildCmd},
						} {
							<div class="border-input flex h-8 w-full min-w-0 items-center overflow-hidden rounded-lg border focus-within:border-ring focus-within:ring-3 focus-within:ring-ring/50">
								<label for={ c.id } class="text-muted-foreground bg-muted/60 flex h-full w-16 shrink-0 items-center border-r px-2.5 text-xs">{ c.label }</label>
								<input id={ c.id } name={ c.name } type="text" placeholder={ c.ph } value={ c.val } class="placeholder:text-muted-foreground/55 h-full min-w-0 flex-1 bg-transparent px-2.5 font-mono text-sm outline-none" { noAutofill... }/>
							</div>
						}
					</div>
				}
			</div>
		</details>
		@formBar() {
			if editing {
				@button.Button(button.Props{Href: "/repos/" + itoa64(edit.ID) + "/resolve", Variant: button.VariantGhost, Size: button.SizeSm}) {
					@icon.Search(icon.Props{Class: "size-3.5"})
					Test configuration
				}
				<span class="text-muted-foreground hidden text-xs md:inline">Dry run: clones the repo and shows what would happen, without touching GitHub.</span>
			}
			<div class="ml-auto flex items-center gap-2">
				@button.Button(button.Props{Href: cancelHref(editing, edit.ID), Variant: button.VariantOutline, Size: button.SizeSm}) {
					Cancel
				}
				@button.Button(button.Props{Type: button.TypeSubmit, Size: button.SizeSm}) {
					{ bindingSubmitLabel(editing) }
				}
			</div>
		}
	</form>
}
