package pages

import (
	"github.com/openpreflight/openpreflight/internal/web"
	"github.com/openpreflight/openpreflight/internal/web/components/badge"
	"github.com/openpreflight/openpreflight/internal/web/components/button"
	"github.com/openpreflight/openpreflight/internal/web/components/card"
	"github.com/openpreflight/openpreflight/internal/web/components/checkbox"
	"github.com/openpreflight/openpreflight/internal/web/components/empty"
	"github.com/openpreflight/openpreflight/internal/web/components/field"
	"github.com/openpreflight/openpreflight/internal/web/components/icon"
	"github.com/openpreflight/openpreflight/internal/web/components/input"
	selectcomp "github.com/openpreflight/openpreflight/internal/web/components/select"
	"github.com/openpreflight/openpreflight/internal/web/layouts"
)

templ Repos(p web.Page) {
	@layouts.Shell(p) {
		@reposList(p)
	}
}

templ ReposPick(p web.Page) {
	{{ m := asMap(p.Data) }}
	{{ apps := appsOf(m) }}
	@layouts.Shell(p) {
		@layouts.PageHead("Pick repositories", "Choose an App, optionally a Coolify source, then check the repos this worker should run.")
		if len(apps) == 0 {
			@reposNeedApp()
		} else {
			@reposApps(p)
		}
	}
}

templ ReposEditorPage(p web.Page) {
	{{ m := asMap(p.Data) }}
	{{ apps := appsOf(m) }}
	{{ editing := has(m, "Edit") }}
	@layouts.Shell(p) {
		@layouts.PageHead(bindingFormTitle(editing), "A binding is one owner/name on one App. Empty branches and paths allow everything.")
		if len(apps) == 0 {
			@reposNeedApp()
		} else {
			@reposEditor(p)
		}
	}
}

templ reposList(p web.Page) {
	{{ m := asMap(p.Data) }}
	{{ apps := appsOf(m) }}
	{{ rows := rowsOf(m) }}
	@layouts.PageHead("Repos", "The worker's allow-list is this page. A repo with no enabled binding is ignored, even if its webhook signature is valid.") {
		if len(apps) > 0 {
			@button.Button(button.Props{Href: "/repos/pick", Size: button.SizeSm}) {
				Pick repositories
			}
			@button.Button(button.Props{Href: "/repos/new", Variant: button.VariantOutline, Size: button.SizeSm}) {
				Add a binding
			}
		}
	}
	if len(rows) > 0 {
		<div class="mb-6 grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
			for _, row := range rows {
				@card.Card(card.Props{Size: card.SizeSm}) {
					@card.Header() {
						@card.Title(card.TitleProps{Class: "font-mono truncate"}) {
							<a class="hover:underline" href={ templ.SafeURL("/repos/" + itoa64(row.Binding.ID)) } title={ row.Binding.Repo }>{ row.Binding.Repo }</a>
						}
						// Whether the repo is checked at all is the one thing worth
						// reading without moving your eyes off the name.
						@card.Action() {
							if row.Binding.Enabled {
								@badge.Badge() {
									on
								}
							} else {
								@badge.Badge(badge.Props{Variant: badge.VariantSecondary}) {
									off
								}
							}
						}
					}
					@card.Content(card.ContentProps{Class: "space-y-2"}) {
						{{ filter := bindingFilterLine(row) }}
						<div class="flex flex-wrap items-center gap-2">
							if row.Binding.ShareableLogs {
								@badge.Badge(badge.Props{Variant: badge.VariantOutline}) {
									shareable
								}
							} else {
								@badge.Badge(badge.Props{Variant: badge.VariantSecondary}) {
									private
								}
							}
							<span class="text-muted-foreground min-w-0 truncate text-xs" title={ filter }>{ filter }</span>
						</div>
						@LastRun(row.LastJob)
					}
					// Edit and Dry run live on the repo's own page, one click through
					// the title. The footer keeps the two actions that change state.
					@card.Footer(card.FooterProps{Class: "flex flex-wrap gap-2"}) {
						<form method="post" action={ templ.SafeURL("/api/v1/bindings/" + itoa64(row.Binding.ID) + "/toggle") } class="m-0">
							@layouts.CSRF(p.CSRFToken)
							@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantOutline, Size: button.SizeSm}) {
								if row.Binding.Enabled {
									Disable
								} else {
									Enable
								}
							}
						</form>
						@layouts.Confirm(layouts.ConfirmProps{
							ID:          "del-bind-" + itoa64(row.Binding.ID),
							Token:       p.CSRFToken,
							Action:      "/api/v1/bindings/" + itoa64(row.Binding.ID) + "/delete",
							Trigger:     "Remove",
							Title:       "Remove this binding?",
							Description: "The repo stops being checked.",
						})
					}
				}
			}
		</div>
	} else if len(apps) == 0 {
		@reposNeedApp()
	} else {
		@empty.Empty(empty.Props{Class: emptyPageClass}) {
			@empty.Header() {
				@empty.Media(empty.MediaProps{Variant: empty.MediaVariantIcon}) {
					@icon.FolderGit()
				}
				@empty.Title() {
					No bindings yet
				}
				@empty.Description() {
					Pick repositories from an App, or add a binding by owner/name.
				}
			}
			@empty.Content() {
				@button.Button(button.Props{Href: "/repos/pick", Size: button.SizeSm}) {
					Pick repositories
				}
				@button.Button(button.Props{Href: "/repos/new", Variant: button.VariantOutline, Size: button.SizeSm}) {
					Add a binding
				}
			}
		}
	}
	if len(rows) > 0 && len(apps) == 0 {
		@reposNeedApp()
	}
}

templ reposNeedApp() {
	@empty.Empty(empty.Props{Class: emptyPageClass}) {
		@empty.Header() {
			@empty.Media(empty.MediaProps{Variant: empty.MediaVariantIcon}) {
				@icon.Github()
			}
			@empty.Title() {
				Add a CI GitHub App first
			}
			@empty.Description() {
				A binding needs an App: it verifies the webhook signature and writes the Check Run.
			}
		}
		@empty.Content() {
			@button.Button(button.Props{Href: "/github-apps/new", Size: button.SizeSm}) {
				Add one
			}
		}
	}
}

templ reposApps(p web.Page) {
	{{ m := asMap(p.Data) }}
	{{ apps := appsOf(m) }}
	{{ instances := instancesOf(m) }}
	{{ selectedApp := asInt64(m, "SelectedAppID") }}
	{{ selectedCoolify := asInt64(m, "SelectedCoolifyID") }}
	{{ picker := pickerOf(m) }}
	@card.Card() {
		@card.Content(card.ContentProps{Class: "space-y-4"}) {
			// onchange sits on the form, not on each select: the component
			// submits its value through a hidden input whose change event
			// bubbles, and picking a source should reload the list without a
			// second click, exactly as it did before.
			<form method="get" action="/repos/pick" class="grid gap-4 sm:grid-cols-3" onchange="this.submit()">
				@field.Field() {
					@field.Label(field.LabelProps{For: "app_id"}) {
						CI GitHub App
					}
					@selectcomp.Select(selectcomp.Props{ID: "app_id-list", Name: "app_id", DefaultValue: idValue(selectedApp)}) {
						@selectcomp.Trigger(selectcomp.TriggerProps{ID: "app_id", Class: "w-full"}) {
							@selectcomp.Value(selectcomp.ValueProps{Placeholder: "- select -"})
						}
						@selectcomp.Content() {
							for _, a := range apps {
								@selectcomp.Item(selectcomp.ItemProps{Value: itoa64(a.ID)}) {
									{ a.Name }
								}
							}
						}
					}
				}
				@field.Field() {
					@field.Label(field.LabelProps{For: "coolify_id"}) {
						Repo list from
					}
					@selectcomp.Select(selectcomp.Props{ID: "coolify_id-list", Name: "coolify_id", DefaultValue: idValue(selectedCoolify)}) {
						@selectcomp.Trigger(selectcomp.TriggerProps{ID: "coolify_id", Class: "w-full"}) {
							@selectcomp.Value(selectcomp.ValueProps{Placeholder: appInstallationsLabel})
						}
						@selectcomp.Content() {
							@selectcomp.Item(selectcomp.ItemProps{Value: ""}) {
								{ appInstallationsLabel }
							}
							for _, inst := range instances {
								@selectcomp.Item(selectcomp.ItemProps{Value: itoa64(inst.ID)}) {
									Coolify: { inst.Name }
								}
							}
						}
					}
					@field.Description() {
						A Coolify connector's repo list is inventory only; the App above still does the webhook, the check and the clone.
					}
				}
				<div class="flex items-end">
					@button.Button(button.Props{Type: button.TypeSubmit, Size: button.SizeSm, Variant: button.VariantSecondary}) {
						Load repositories
					}
				</div>
			</form>
			@layouts.Toast(pickerError(m), "err")
			if len(picker) > 0 {
				<form method="post" action="/api/v1/bindings/bulk" class="space-y-3">
					@layouts.CSRF(p.CSRFToken)
					<input type="hidden" name="github_app_id" value={ itoa64(selectedApp) }/>
					<input type="hidden" name="coolify_instance_id" value={ itoa64(selectedCoolify) }/>
					for _, r := range picker {
						@field.Field(field.Props{Orientation: field.OrientationHorizontal, Class: "items-center"}) {
							@checkbox.Checkbox(checkbox.Props{
								ID:             "repo-" + r.FullName,
								Name:           "repo",
								Value:          r.FullName,
								DefaultChecked: r.Bound,
							})
							@field.Label(field.LabelProps{For: "repo-" + r.FullName, Class: "font-mono"}) {
								{ r.FullName }
							}
							if r.Private {
								@badge.Badge(badge.Props{Variant: badge.VariantSecondary}) {
									private
								}
							}
							if r.Bound {
								@badge.Badge() {
									bound
								}
							}
						}
					}
					@field.Description() {
						Unchecking a repo removes its binding. Only private repos you trust should be enabled: a pipeline runs the repo's own commands on this host.
					}
					@button.Button(button.Props{Type: button.TypeSubmit, Size: button.SizeSm}) {
						Save selection
					}
				</form>
			} else if selectedApp != 0 && pickerError(m) == "" {
				@empty.Empty(empty.Props{Class: emptyInCardClass}) {
					@empty.Header() {
						@empty.Media(empty.MediaProps{Variant: empty.MediaVariantIcon}) {
							@icon.FolderGit()
						}
						@empty.Title() {
							No repositories on this source
						}
						@empty.Description() {
							Install the App on a GitHub account or org, or pick a Coolify connector that has repos, then load again.
						}
					}
				}
			}
		}
	}
}

templ reposEditor(p web.Page) {
	@card.Card() {
		@card.Content() {
			@reposEditorForm(p)
		}
	}
}

templ reposEditorForm(p web.Page) {
	{{ m := asMap(p.Data) }}
	{{ settings := settingsOf(m) }}
	{{ apps := appsOf(m) }}
	{{ instances := instancesOf(m) }}
	{{ editing := has(m, "Edit") }}
	{{ edit := bindingOf(m) }}
	<form method="post" action="/api/v1/bindings" class="flex flex-col gap-4">
		@layouts.CSRF(p.CSRFToken)
		<div class="grid gap-4 sm:grid-cols-3">
			@field.Field() {
				@field.Label(field.LabelProps{For: "b_repo"}) {
					Repo (owner/name)
				}
				@input.Input(input.Props{ID: "b_repo", Name: "repo", Type: "text", Class: "font-mono", Required: true, Value: edit.Repo, ReadOnly: editing})
			}
			@field.Field() {
				@field.Label(field.LabelProps{For: "b_app"}) {
					CI GitHub App
				}
				// A native select submits its first option when nothing is chosen.
				// This one submits only what is selected, so the first App is the
				// explicit default on a new binding rather than an accident of order.
				@selectcomp.Select(selectcomp.Props{ID: "b_app-list", Name: "github_app_id", Required: true, DefaultValue: editAppValue(editing, edit.GitHubAppID, apps)}) {
					@selectcomp.Trigger(selectcomp.TriggerProps{ID: "b_app", Class: "w-full"}) {
						@selectcomp.Value(selectcomp.ValueProps{Placeholder: firstAppName(apps)})
					}
					@selectcomp.Content() {
						for _, a := range apps {
							@selectcomp.Item(selectcomp.ItemProps{Value: itoa64(a.ID)}) {
								{ a.Name }
							}
						}
					}
				}
			}
			@field.Field() {
				@field.Label(field.LabelProps{For: "b_coolify"}) {
					Coolify instance
				}
				@selectcomp.Select(selectcomp.Props{ID: "b_coolify-list", Name: "coolify_instance_id", DefaultValue: editInstValue(editing, edit.CoolifyInstanceID)}) {
					@selectcomp.Trigger(selectcomp.TriggerProps{ID: "b_coolify", Class: "w-full"}) {
						@selectcomp.Value(selectcomp.ValueProps{Placeholder: "none"})
					}
					@selectcomp.Content() {
						@selectcomp.Item(selectcomp.ItemProps{Value: "0"}) {
							none
						}
						for _, inst := range instances {
							@selectcomp.Item(selectcomp.ItemProps{Value: itoa64(inst.ID)}) {
								{ inst.Name }
							}
						}
					}
				}
			}
		</div>
		<div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
			@field.Field() {
				@field.Label(field.LabelProps{For: "b_branches"}) {
					Branches
				}
				@input.Input(input.Props{ID: "b_branches", Name: "branches", Type: "text", Placeholder: branchesPlaceholder, Value: edit.Branches})
				@field.Description() {
					Empty allows every branch.
				}
			}
			@field.Field() {
				@field.Label(field.LabelProps{For: "b_paths"}) {
					Paths
				}
				@input.Input(input.Props{ID: "b_paths", Name: "paths", Type: "text", Placeholder: "frontend/**, packages/api/**", Value: edit.Paths})
				@field.Description() {
					Empty allows every path. Skip (Check Run conclusion skipped) when no changed file matches.
				}
			}
			@field.Field() {
				@field.Label(field.LabelProps{For: "b_on_empty"}) {
					Empty pipeline
				}
				@selectcomp.Select(selectcomp.Props{ID: "b_on_empty-list", Name: "on_empty_pipeline", DefaultValue: onEmptyValue(edit.OnEmptyPipeline)}) {
					@selectcomp.Trigger(selectcomp.TriggerProps{ID: "b_on_empty", Class: "w-full"}) {
						@selectcomp.Value(selectcomp.ValueProps{Placeholder: "Skip the job"})
					}
					@selectcomp.Content() {
						@selectcomp.Item(selectcomp.ItemProps{Value: "skip"}) {
							Skip the job
						}
						@selectcomp.Item(selectcomp.ItemProps{Value: "fail"}) {
							Fail the job
						}
					}
				}
				@field.Description() {
					What to do when nothing resolves to run: no pipeline file, no commands
					here, and no recognisable project. Usually a misconfiguration rather
					than an intention.
				}
			}
			@field.Field() {
				@field.Label(field.LabelProps{For: "b_check"}) {
					Check name
				}
				@input.Input(input.Props{ID: "b_check", Name: "check_name", Type: "text", Placeholder: settings.DefaultCheckName, Value: edit.CheckName})
			}
			@field.Field() {
				@field.Label(field.LabelProps{For: "b_file"}) {
					Pipeline file
				}
				@input.Input(input.Props{ID: "b_file", Name: "pipeline_file", Type: "text", Placeholder: settings.DefaultPipelineFile, Value: edit.PipelineFile})
			}
			@field.Field() {
				@field.Label(field.LabelProps{For: "b_timeout"}) {
					Timeout (seconds)
				}
				@input.Input(input.Props{ID: "b_timeout", Name: "timeout_seconds", Type: "number", Placeholder: itoa(settings.DefaultTimeoutSeconds), Value: timeoutVal(edit.TimeoutSeconds), Attributes: templ.Attributes{"min": "0"}})
				@field.Description() {
					0 or blank inherits.
				}
			}
		</div>
		<h2 class="text-base font-semibold">Command overrides</h2>
		<p class="text-muted-foreground text-xs">Used only when the repo has no pipeline file. Leave blank to fall back to Node defaults inferred from package.json.</p>
		<div class="grid gap-4 sm:grid-cols-3">
			@field.Field() {
				@field.Label(field.LabelProps{For: "b_install"}) {
					install
				}
				@input.Input(input.Props{ID: "b_install", Name: "install_cmd", Type: "text", Class: "font-mono", Value: edit.InstallCmd})
			}
			@field.Field() {
				@field.Label(field.LabelProps{For: "b_test"}) {
					test
				}
				@input.Input(input.Props{ID: "b_test", Name: "test_cmd", Type: "text", Class: "font-mono", Value: edit.TestCmd})
			}
			@field.Field() {
				@field.Label(field.LabelProps{For: "b_build"}) {
					build
				}
				@input.Input(input.Props{ID: "b_build", Name: "build_cmd", Type: "text", Class: "font-mono", Value: edit.BuildCmd})
			}
		</div>
		@field.Field(field.Props{Orientation: field.OrientationHorizontal, Class: "items-center"}) {
			@checkbox.Checkbox(checkbox.Props{ID: "b_enabled", Name: "enabled", Value: "1", DefaultChecked: bindingEnabledChecked(editing, edit.Enabled)})
			@field.Label(field.LabelProps{For: "b_enabled"}) {
				Enabled
			}
		}
		@field.Field(field.Props{Orientation: field.OrientationHorizontal, Class: "items-center"}) {
			@checkbox.Checkbox(checkbox.Props{ID: "b_shareable", Name: "shareable_logs", Value: "1", DefaultChecked: shareableChecked(editing, edit.ShareableLogs)})
			@field.Label(field.LabelProps{For: "b_shareable"}) {
				Shareable logs
			}
		}
		@field.Description() {
			Off by default. On, anyone with a job's /runs/id link can read its full build output without signing in. Job ids are random, but treat the link as a secret.
		}
		<div class="flex flex-wrap items-center gap-2">
			@button.Button(button.Props{Type: button.TypeSubmit, Size: button.SizeSm}) {
				{ bindingSubmitLabel(editing) }
			}
			if editing {
				@button.Button(button.Props{Href: "/repos/" + itoa64(edit.ID) + "/resolve", Variant: button.VariantOutline, Size: button.SizeSm}) {
					Test configuration
				}
			}
			@button.Button(button.Props{Href: "/repos", Variant: button.VariantOutline, Size: button.SizeSm}) {
				Cancel
			}
		</div>
	</form>
}
