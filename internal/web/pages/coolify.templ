package pages

import (
	"github.com/openpreflight/openpreflight/internal/web"
	"github.com/openpreflight/openpreflight/internal/web/components/badge"
	"github.com/openpreflight/openpreflight/internal/web/components/button"
	"github.com/openpreflight/openpreflight/internal/web/components/card"
	"github.com/openpreflight/openpreflight/internal/web/components/empty"
	"github.com/openpreflight/openpreflight/internal/web/components/field"
	"github.com/openpreflight/openpreflight/internal/web/components/icon"
	"github.com/openpreflight/openpreflight/internal/web/components/input"
	"github.com/openpreflight/openpreflight/internal/web/components/table"
	"github.com/openpreflight/openpreflight/internal/web/layouts"
)

templ Coolify(p web.Page) {
	{{ m := asMap(p.Data) }}
	{{ instances := instancesOf(m) }}
	{{ editing := has(m, "Edit") }}
	{{ edit := instOf(m, "Edit") }}
	@layouts.Shell(p) {
		@layouts.PageHead("Coolify instances", "One row is one (base URL, API token) pair. A Coolify API token is scoped to a single team, so a row covers that team - not the whole host. A second team on the same host is a second row.") {
			@button.Button(button.Props{Href: "#add", Size: button.SizeSm}) {
				Add an instance
			}
		}
		if len(instances) > 0 {
			<div class="mb-6 grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
				for _, inst := range instances {
					@card.Card(card.Props{Size: card.SizeSm}) {
						@card.Header() {
							@card.Title(card.TitleProps{Class: "truncate"}) {
								{ inst.Name }
							}
							@card.Description(card.DescriptionProps{Class: "font-mono"}) {
								{ inst.BaseURL }
							}
						}
						@card.Content(card.ContentProps{Class: "space-y-2"}) {
							<div class="flex flex-wrap items-center gap-2">
								@badge.Badge(badge.Props{Variant: healthVariant(inst.LastError, inst.LastSeenAt != nil)}) {
									{ healthLabel(inst.LastError, inst.LastSeenAt != nil) }
								}
								if inst.TeamName != "" {
									<span class="text-xs">{ inst.TeamName } <span class="text-muted-foreground">#{ inst.TeamID }</span></span>
								} else {
									<span class="text-muted-foreground text-xs">untested</span>
								}
							</div>
							<div class="font-mono text-xs">{ inst.APITokenRedacted }</div>
							if inst.LastError != "" {
								<p class="text-muted-foreground text-xs">{ inst.LastError }</p>
							} else if inst.LastSeenAt != nil {
								<p class="text-muted-foreground text-xs">{ agoPtr(inst.LastSeenAt) }</p>
							}
						}
						@card.Footer(card.FooterProps{Class: "flex flex-wrap gap-2"}) {
							<form method="post" action={ templ.SafeURL("/api/v1/coolify/" + itoa64(inst.ID) + "/test") } class="m-0">
								@layouts.CSRF(p.CSRFToken)
								@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantLink, Size: button.SizeSm}) {
									Test
								}
							</form>
							@button.Button(button.Props{Href: "/coolify?edit=" + itoa64(inst.ID), Variant: button.VariantLink, Size: button.SizeSm}) {
								Edit
							}
							@button.Button(button.Props{Href: "/coolify?inspect=" + itoa64(inst.ID), Variant: button.VariantLink, Size: button.SizeSm}) {
								Inspect
							}
							@layouts.ConfirmDelete(
								"del-coolify-"+itoa64(inst.ID),
								p.CSRFToken,
								"/api/v1/coolify/"+itoa64(inst.ID)+"/delete",
								"Remove",
								"Remove this Coolify instance?",
								"Bindings that name it keep working.",
							)
						}
					}
				}
			</div>
		} else {
			@empty.Empty(empty.Props{Class: emptyPageClass}) {
				@empty.Header() {
					@empty.Media(empty.MediaProps{Variant: empty.MediaVariantIcon}) {
						@icon.Server()
					}
					@empty.Title() {
						No instances yet
					}
					@empty.Description() {
						Coolify is optional: inventory and a repo picker. The CI GitHub App is what runs checks. Add one with the form below.
					}
				}
			}
		}
		if has(m, "Inspect") {
			{{ inspect := instOf(m, "Inspect") }}
			{{ servers := serversOf(m) }}
			{{ connectors := connectorsOf(m) }}
			@card.Card(card.Props{Class: "mb-6"}) {
				@card.Header() {
					@card.Title() {
						{ inspect.Name }
					}
				}
				@card.Content(card.ContentProps{Class: "space-y-4"}) {
					if errMsg := str(m, "InspectError"); errMsg != "" {
						@badge.Badge(badge.Props{Variant: badge.VariantDestructive}) {
							{ errMsg }
						}
					}
					if len(servers) > 0 {
						<h2 class="text-base font-semibold">Servers in this team</h2>
						@table.Table() {
							@table.Header() {
								@table.Row() {
									@table.Head() {
										Name
									}
									@table.Head() {
										IP
									}
									@table.Head() {
										UUID
									}
								}
							}
							@table.Body() {
								for _, s := range servers {
									@table.Row() {
										@table.Cell() {
											{ s.Name }
										}
										@table.Cell(table.CellProps{Class: "font-mono text-xs"}) {
											{ s.IP }
										}
										@table.Cell(table.CellProps{Class: "font-mono text-xs"}) {
											{ s.UUID }
										}
									}
								}
							}
						}
					}
					if len(connectors) > 0 {
						<h2 class="text-base font-semibold">GitHub connectors (deploy sources)</h2>
						<p class="text-muted-foreground text-xs">
							These are Coolify's deploy sources. They cannot write commit checks - no
							<code class="font-mono">checks</code> permission, and their webhook belongs to Coolify. They are useful here as a repo
							list.
						</p>
						@table.Table() {
							@table.Header() {
								@table.Row() {
									@table.Head() {
										Name
									}
									@table.Head() {
										App ID
									}
									@table.Head() {
										Installation
									}
									@table.Head() {
										UUID
									}
								}
							}
							@table.Body() {
								for _, c := range connectors {
									@table.Row() {
										@table.Cell() {
											{ c.Name }
										}
										@table.Cell(table.CellProps{Class: "font-mono text-xs"}) {
											{ string(c.AppID) }
										}
										@table.Cell(table.CellProps{Class: "font-mono text-xs"}) {
											{ string(c.InstallationID) }
										}
										@table.Cell(table.CellProps{Class: "font-mono text-xs"}) {
											{ c.UUID }
										}
									}
								}
							}
						}
					}
					<h2 class="text-base font-semibold">Install this worker on a Coolify server</h2>
					<p class="text-muted-foreground mb-3 text-xs">
						Creates a Docker Compose application via Coolify's API. Set
						<code class="font-mono">CI_SECRET_KEY</code> on the application before the first deploy. Needs a server UUID and
						a project UUID (from the instance defaults, or filled in below).
					</p>
					<form method="post" action={ templ.SafeURL("/api/v1/coolify/" + itoa64(inspect.ID) + "/install-worker") } class="flex flex-col gap-4">
						@layouts.CSRF(p.CSRFToken)
						<div class="grid gap-4 sm:grid-cols-2">
							@field.Field() {
								@field.Label(field.LabelProps{For: "install_server_uuid"}) {
									Server UUID
								}
								@input.Input(input.Props{ID: "install_server_uuid", Name: "server_uuid", Type: "text", Value: inspect.DefaultServerUUID, Required: true})
							}
							@field.Field() {
								@field.Label(field.LabelProps{For: "install_project_uuid"}) {
									Project UUID
								}
								@input.Input(input.Props{ID: "install_project_uuid", Name: "project_uuid", Type: "text", Value: inspect.DefaultProjectUUID, Required: true})
							}
							@field.Field() {
								@field.Label(field.LabelProps{For: "install_name"}) {
									Application name
								}
								@input.Input(input.Props{ID: "install_name", Name: "name", Type: "text", Value: "openpreflight"})
							}
							@field.Field() {
								@field.Label(field.LabelProps{For: "install_env"}) {
									Environment
								}
								@input.Input(input.Props{ID: "install_env", Name: "environment_name", Type: "text", Value: "production"})
							}
						</div>
						@button.Button(button.Props{Type: button.TypeSubmit, Size: button.SizeSm, Variant: button.VariantSecondary}) {
							Create application
						}
					</form>
				}
			}
		}
		@card.Card(card.Props{ID: "add"}) {
			@card.Header() {
				@card.Title() {
					if editing {
						Edit { edit.Name }
					} else {
						Add an instance
					}
				}
			}
			@card.Content() {
				<form method="post" action={ templ.SafeURL(coolifyFormAction(editing, edit.ID)) } class="flex flex-col gap-4">
					@layouts.CSRF(p.CSRFToken)
					<div class="grid gap-4 sm:grid-cols-2">
						@field.Field() {
							@field.Label(field.LabelProps{For: "name"}) {
								Name
							}
							@input.Input(input.Props{ID: "name", Name: "name", Type: "text", Placeholder: "prod-platform", Value: edit.Name})
						}
						@field.Field() {
							@field.Label(field.LabelProps{For: "base_url"}) {
								Base URL
							}
							@input.Input(input.Props{ID: "base_url", Name: "base_url", Type: "url", Placeholder: "https://coolify.example.com", Required: true, Value: edit.BaseURL})
						}
					</div>
					@field.Field() {
						@field.Label(field.LabelProps{For: "api_token"}) {
							API token
						}
						@input.Input(input.Props{ID: "api_token", Name: "api_token", Type: "password", Placeholder: "3|Waobq…", Required: !editing})
						@field.Description() {
							if editing {
								Leave blank to keep the stored token. Current: <span class="font-mono">{ edit.APITokenRedacted }</span>
							} else {
								Coolify UI: <strong>Security → API Tokens</strong> (some versions:
								<strong>Keys &amp; Tokens</strong>). Read-only is enough for inventory. The token is stored
								encrypted and never shown again.
							}
						}
					}
					<div class="flex flex-wrap items-center gap-2">
						@button.Button(button.Props{Type: button.TypeSubmit, Size: button.SizeSm}) {
							if editing {
								Save
							} else {
								Add and test
							}
						}
						if editing {
							@button.Button(button.Props{Href: "/coolify", Variant: button.VariantOutline, Size: button.SizeSm}) {
								Cancel
							}
						}
					</div>
				</form>
			}
		}
	}
}
