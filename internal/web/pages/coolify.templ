package pages

import (
	"github.com/openpreflight/openpreflight/internal/store"
	"github.com/openpreflight/openpreflight/internal/web"
	"github.com/openpreflight/openpreflight/internal/web/components/icon"
	"github.com/openpreflight/openpreflight/internal/web/components/button"
	"github.com/openpreflight/openpreflight/internal/web/components/field"
	"github.com/openpreflight/openpreflight/internal/web/components/input"
	"github.com/openpreflight/openpreflight/internal/web/components/table"
	"github.com/openpreflight/openpreflight/internal/web/layouts"
)

templ Coolify(p web.Page) {
	{{ m := asMap(p.Data) }}
	{{ instances := instancesOf(m) }}
	{{ editing := has(m, "Edit") }}
	{{ edit := instOf(m, "Edit") }}
	@layouts.Shell(p) {
		@layouts.PageHead("Coolify", "Optional. A Coolify team gives this worker a server inventory and its GitHub connectors as a repo source. Coolify never runs or reports the checks.")
		if len(instances) > 0 {
			@layouts.ListCard() {
				@layouts.ListHead("Instances", len(instances), "One per API token. A token covers one team, so a second team on the same host is a second instance.")
				@layouts.List() {
					for _, inst := range instances {
						@coolifyRow(p, inst)
					}
				}
			}
		}
		if has(m, "Inspect") {
			{{ inspect := instOf(m, "Inspect") }}
			{{ servers := serversOf(m) }}
			{{ connectors := connectorsOf(m) }}
			<div id="inspect" class="scroll-mt-20">
				@layouts.ListCard() {
				@layouts.ListHead(inspect.Name+" · inspect", -1, "What this token can see, and installing this worker through Coolify.") {
					@button.Button(button.Props{Href: "/coolify", Variant: button.VariantGhost, Size: button.SizeSm}) {
						Close
					}
				}
				<div class="space-y-4 p-4">
					@layouts.Notice(layouts.ToneDanger, "Could not read this instance", str(m, "InspectError"))
					if len(servers) > 0 {
						<h2 class="text-base font-semibold">Servers in this team</h2>
						@table.Table() {
							@table.Header() {
								@table.Row() {
									@table.Head() {
										Name
									}
									@table.Head() {
										IP
									}
									@table.Head() {
										UUID
									}
								}
							}
							@table.Body() {
								for _, s := range servers {
									@table.Row() {
										@table.Cell() {
											{ s.Name }
										}
										@table.Cell(table.CellProps{Class: "font-mono text-xs"}) {
											{ s.IP }
										}
										@table.Cell(table.CellProps{Class: "font-mono text-xs"}) {
											{ s.UUID }
										}
									}
								}
							}
						}
					}
					if len(connectors) > 0 {
						<h2 class="text-base font-semibold">GitHub connectors (deploy sources)</h2>
						<p class="text-muted-foreground text-xs">
							These are Coolify's deploy sources. They cannot write commit checks - no
							<code class="font-mono">checks</code> permission, and their webhook belongs to Coolify. They are useful here as a repo
							list.
						</p>
						@table.Table() {
							@table.Header() {
								@table.Row() {
									@table.Head() {
										Name
									}
									@table.Head() {
										App ID
									}
									@table.Head() {
										Installation
									}
									@table.Head() {
										UUID
									}
								}
							}
							@table.Body() {
								for _, c := range connectors {
									@table.Row() {
										@table.Cell() {
											{ c.Name }
										}
										@table.Cell(table.CellProps{Class: "font-mono text-xs"}) {
											{ string(c.AppID) }
										}
										@table.Cell(table.CellProps{Class: "font-mono text-xs"}) {
											{ string(c.InstallationID) }
										}
										@table.Cell(table.CellProps{Class: "font-mono text-xs"}) {
											{ c.UUID }
										}
									}
								}
							}
						}
					}
					<h2 class="text-base font-semibold">Install this worker on a Coolify server</h2>
					<p class="text-muted-foreground mb-3 text-xs">
						Creates a Docker Compose application via Coolify's API. Set
						<code class="font-mono">CI_SECRET_KEY</code> on the application before the first deploy. Needs a server UUID and
						a project UUID (from the instance defaults, or filled in below).
					</p>
					<form method="post" action={ templ.SafeURL("/api/v1/coolify/" + itoa64(inspect.ID) + "/install-worker") } class="flex flex-col gap-4">
						@layouts.CSRF(p.CSRFToken)
						<div class="grid gap-4 sm:grid-cols-2">
							@field.Field() {
								@field.Label(field.LabelProps{For: "install_server_uuid"}) {
									Server UUID
								}
								@input.Input(input.Props{ID: "install_server_uuid", Name: "server_uuid", Type: "text", Value: inspect.DefaultServerUUID, Required: true})
							}
							@field.Field() {
								@field.Label(field.LabelProps{For: "install_project_uuid"}) {
									Project UUID
								}
								@input.Input(input.Props{ID: "install_project_uuid", Name: "project_uuid", Type: "text", Value: inspect.DefaultProjectUUID, Required: true})
							}
							@field.Field() {
								@field.Label(field.LabelProps{For: "install_name"}) {
									Application name
								}
								@input.Input(input.Props{ID: "install_name", Name: "name", Type: "text", Value: "openpreflight"})
							}
							@field.Field() {
								@field.Label(field.LabelProps{For: "install_env"}) {
									Environment
								}
								@input.Input(input.Props{ID: "install_env", Name: "environment_name", Type: "text", Value: "production"})
							}
						</div>
						@button.Button(button.Props{Type: button.TypeSubmit, Size: button.SizeSm, Variant: button.VariantSecondary, Class: "self-start"}) {
							Create application
						}
					</form>
				</div>
				}
			</div>
		}
		@coolifyForm(p, editing, edit, len(instances) == 0)
	}
}

// coolifyForm adds or edits an instance. It is folded away under the list
// once there is something in the list, and open when editing or when it is the
// only thing on the page.
templ coolifyForm(p web.Page, editing bool, edit store.CoolifyInstance, alone bool) {
	<details id="add" data-slot="list-card" class="group bg-muted/60 text-card-foreground mb-6 scroll-mt-20 rounded-xl border p-1" open?={ editing || alone }>
		<summary data-slot="list-head" class="flex cursor-pointer list-none items-center gap-2 px-3 pt-2 pb-2.5 [&::-webkit-details-marker]:hidden">
			@icon.ChevronRight(icon.Props{Class: "text-muted-foreground size-4 transition-transform group-open:rotate-90"})
			<h2 class="text-sm font-semibold">
				if editing {
					Edit { edit.Name }
				} else {
					Add an instance
				}
			</h2>
		</summary>
		<form method="post" action={ templ.SafeURL(coolifyFormAction(editing, edit.ID)) }>
			@layouts.CSRF(p.CSRFToken)
			<div class="divide-y">
				@fieldRow("name", "Name", "Yours, to tell instances apart. Blank uses the base URL.") {
					@input.Input(input.Props{ID: "name", Name: "name", Type: "text", Placeholder: "prod-platform", Value: edit.Name, Attributes: noAutofill})
				}
				@fieldRow("base_url", "Base URL", "The Coolify root as this worker reaches it, not through a login page. On the same host that is usually http://127.0.0.1:8000.") {
					@input.Input(input.Props{ID: "base_url", Name: "base_url", Type: "url", Class: "font-mono", Placeholder: "https://coolify.example.com", Required: true, Value: edit.BaseURL, Attributes: noAutofill})
				}
				@fieldRow("api_token", "API token", coolifyTokenHint(editing, edit.APITokenRedacted)) {
					@input.Input(input.Props{ID: "api_token", Name: "api_token", Type: "password", Placeholder: "3|Waobq…", Required: !editing, Attributes: secretAttrs})
				}
			</div>
			<div class="bg-muted/30 flex items-center justify-end gap-2 border-t px-4 py-3">
				if editing {
					@button.Button(button.Props{Href: "/coolify", Variant: button.VariantOutline, Size: button.SizeSm}) {
						Cancel
					}
				}
				@button.Button(button.Props{Type: button.TypeSubmit, Size: button.SizeSm}) {
					if editing {
						Save changes
					} else {
						Add and test
					}
				}
			</div>
		</form>
	</details>
}

func coolifyTokenHint(editing bool, redacted string) string {
	if editing {
		return "Leave blank to keep the stored token. Current: " + redacted
	}
	return "In Coolify: Security → API Tokens (some versions: Keys & Tokens). Read-only is enough. Stored encrypted and never shown again."
}

// coolifyRow is one instance: what it is, whether its last check worked, and
// the error if not. The name opens the inspect panel.
templ coolifyRow(p web.Page, inst store.CoolifyInstance) {
	{{ label, tone := healthStatus(inst.LastError, inst.LastSeenAt != nil) }}
	<li class="hover:bg-muted/40 px-4 py-3 transition-colors">
		<div class="flex flex-wrap items-center gap-x-4 gap-y-2">
			<div class="flex min-w-0 flex-1 basis-64 items-center gap-3">
				<span class="bg-muted flex size-9 shrink-0 items-center justify-center rounded-lg">
					@icon.Server(icon.Props{Class: "size-4"})
				</span>
				<div class="min-w-0">
					<a href={ templ.SafeURL("/coolify?inspect=" + itoa64(inst.ID) + "#inspect") } class="block truncate text-sm font-medium underline-offset-4 hover:underline" title="Servers, connectors and install">{ inst.Name }</a>
					<p class="text-muted-foreground truncate text-xs">
						<span class="font-mono">{ inst.BaseURL }</span>
						if inst.TeamName != "" {
							· { inst.TeamName }
						}
					</p>
				</div>
			</div>
			<div class="flex items-center gap-2">
				@layouts.Status(label, tone)
				if inst.LastSeenAt != nil {
					<span class="text-muted-foreground text-xs" title="Last successful check">{ agoPtr(inst.LastSeenAt) }</span>
				}
			</div>
			<div class="ml-auto flex items-center gap-1">
				<form method="post" action={ templ.SafeURL("/api/v1/coolify/" + itoa64(inst.ID) + "/test") } class="m-0">
					@layouts.CSRF(p.CSRFToken)
					@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantOutline, Size: button.SizeSm}) {
						@icon.RefreshCw(icon.Props{Class: "size-3.5"})
						Test
					}
				</form>
				@layouts.RowMenu("coolify-menu-"+itoa64(inst.ID), "More actions for "+inst.Name) {
					<a role="menuitem" class={ layouts.MenuItemClass } href={ templ.SafeURL("/coolify?inspect=" + itoa64(inst.ID) + "#inspect") }>
						@icon.Search()
						Servers and connectors
					</a>
					<a role="menuitem" class={ layouts.MenuItemClass } href={ templ.SafeURL(inst.BaseURL) } target="_blank" rel="noopener">
						@icon.ExternalLink()
						Open Coolify
					</a>
					<a role="menuitem" class={ layouts.MenuItemClass } href={ templ.SafeURL("/coolify?edit=" + itoa64(inst.ID) + "#add") }>
						@icon.Settings()
						Edit
					</a>
					@layouts.MenuSeparator()
					@layouts.Confirm(layouts.ConfirmProps{
						ID:          "del-coolify-" + itoa64(inst.ID),
						Token:       p.CSRFToken,
						Action:      "/api/v1/coolify/" + itoa64(inst.ID) + "/delete",
						Trigger:     "Remove",
						MenuItem:    true,
						Title:       "Remove " + inst.Name + "?",
						Description: "Bindings that name it keep working; Coolify is only bookkeeping for them.",
					})
				}
			</div>
		</div>
		if inst.LastError != "" {
			<p class="text-destructive mt-2 flex items-start gap-1.5 text-xs sm:pl-12">
				@icon.CircleAlert(icon.Props{Class: "mt-px size-3.5 shrink-0"})
				<span class="min-w-0 [overflow-wrap:anywhere]">{ inst.LastError }</span>
			</p>
		}
	</li>
}
