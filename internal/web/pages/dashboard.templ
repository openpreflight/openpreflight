package pages

import (
	"github.com/openpreflight/openpreflight/internal/web"
	"github.com/openpreflight/openpreflight/internal/store"
	"github.com/openpreflight/openpreflight/internal/web/components/button"
	"github.com/openpreflight/openpreflight/internal/web/components/icon"
	"github.com/openpreflight/openpreflight/internal/web/layouts"
)

templ Dashboard(p web.Page) {
	{{ m := asMap(p.Data) }}
	{{ settings := settingsOf(m) }}
	{{ apps := appsOf(m) }}
	{{ coolify := coolifyOf(m) }}
	{{ bindings := bindingsOf(m) }}
	{{ enabled := asInt(m, "EnabledBindings") }}
	{{ inflight := inflightOf(m) }}
	{{ jobs := jobsOf(m) }}
	{{ cards := cardsOf(m) }}
	{{ recent := recentOf(m) }}
	{{ ranAny := asBool(m, "RanAny") }}
	{{ passedAny := asBool(m, "PassedAny") }}
	@layouts.Shell(p) {
		@layouts.PageHead("Overview", dashLede(dashSetupDone(settings.PublicBaseURL, len(apps), enabled, passedAny))) {
			if dashNeedApp(len(apps)) {
				@button.Button(button.Props{Href: "/github-apps/new", Size: button.SizeSm}) {
					Add GitHub App
				}
			}
			if dashNeedRepo(len(apps), enabled) {
				@button.Button(button.Props{Href: "/repos", Size: button.SizeSm}) {
					Enable a repo
				}
			}
		}
		<div class="mb-8 grid grid-cols-2 gap-3 lg:grid-cols-4">
			for _, s := range dashStats(recent, len(inflight), enabled, len(bindings)) {
				@statCard(s)
			}
		</div>
		if !dashSetupDone(settings.PublicBaseURL, len(apps), enabled, passedAny) {
			@layouts.ListCard() {
				@layouts.ListHead("Finish setup", -1, "Coolify is optional. This list goes away once a check has passed.")
				@layouts.List() {
					if settings.PublicBaseURL != "" {
						@setupRow(layouts.ToneSuccess, "done", "Public base URL", settings.PublicBaseURL, true, "/settings", "Settings")
					} else {
						@setupRow(layouts.ToneDanger, "needed", "Public base URL", "", false, "/settings", "Set it in Settings")
					}
					if len(apps) > 0 {
						@setupRow(layouts.ToneSuccess, "done", "CI GitHub App", itoa(len(apps))+" configured", false, "/github-apps", "Manage")
					} else {
						@setupRow(layouts.ToneDanger, "needed", "CI GitHub App", "", false, "/github-apps/new", "Add one")
					}
					if enabled > 0 {
						@setupRow(layouts.ToneSuccess, "done", "Enabled repo", itoa(enabled)+" of "+itoa(len(bindings))+" enabled", false, "/repos", "Manage")
					} else {
						@setupRow(layouts.ToneDanger, "needed", "Enabled repo", dashNoRepoHint(len(bindings)), false, "/repos", "Enable a repo")
					}
					if ranAny {
						@setupRow(layouts.ToneSuccess, "done", "First run", "", false, "/jobs", "View jobs")
					} else {
						@setupRow(layouts.ToneNeutral, "waiting", "First run", "push a commit, and GitHub calls the webhook", false, "", "")
					}
					if passedAny {
						@setupRow(layouts.ToneSuccess, "done", "Passing Check Run", "", false, "", "")
					} else if ranAny {
						@setupRow(layouts.ToneWarning, "not yet", "Passing Check Run", "a run finished, but none has passed — open it to see why", false, "", "")
					} else {
						@setupRow(layouts.ToneNeutral, "waiting", "Passing Check Run", "the commit gets a green check here and on GitHub", false, "", "")
					}
					if len(coolify) > 0 {
						@setupRow(layouts.ToneSuccess, "done", "Coolify", itoa(len(coolify))+" configured · optional", false, "/coolify", "Manage")
					} else {
						@setupRow(layouts.ToneNeutral, "optional", "Coolify", "server inventory and a repo picker", false, "/coolify", "Add an instance")
					}
				}
			}
		}
		if len(inflight) > 0 {
			@layouts.ListCard() {
				@layouts.ListHead("Running now", len(inflight), "") {
					@button.Button(button.Props{Href: "/jobs", Variant: button.VariantLink, Size: button.SizeSm, Class: "h-auto px-0"}) {
						All jobs
					}
				}
				@jobList(p, inflight, true)
			}
		}
		@layouts.ListCard() {
			@layouts.ListHead("Recent jobs", -1, "") {
				@button.Button(button.Props{Href: "/jobs", Variant: button.VariantLink, Size: button.SizeSm, Class: "h-auto px-0"}) {
					All jobs
				}
			}
			if len(jobs) > 0 {
				@jobList(p, jobs, true)
			} else {
				@jobsEmpty(false)
			}
		}
		if len(cards) > 0 {
			@layouts.ListCard() {
				@layouts.ListHead("Enabled repos", len(cards), "") {
					@button.Button(button.Props{Href: "/repos", Variant: button.VariantLink, Size: button.SizeSm, Class: "h-auto px-0"}) {
						All repos
					}
				}
				@layouts.List() {
					for _, c := range cards {
						@repoRow(c.ID, c.Repo, c.LastJob)
					}
				}
			}
		}
	}
}

// repoRow is a repository and what happened to it last. The row opens the
// repo's own page, not the run: it is about the repository.
templ repoRow(id int64, repo string, last store.Job) {
	<li class={ layouts.RowClass }>
		<a class="row-link min-w-0 flex-1 truncate text-sm font-medium" href={ templ.SafeURL("/repos/" + itoa64(id)) } title={ repo }>{ repo }</a>
		if last.ID != "" {
			<span class="text-muted-foreground hidden truncate text-xs sm:inline">{ jobRefLabel(last) } · { web.Ago(last.CreatedAt) }</span>
			@StatusBadge(last)
		} else {
			<span class="text-muted-foreground text-xs">no runs yet</span>
		}
	</li>
}

// setupRow is one line of the setup checklist. The state badge sits in a fixed
// column so every label starts at the same x, whatever the badge says.
templ setupRow(tone layouts.Tone, state, label, detail string, mono bool, href, action string) {
	<li class="grid grid-cols-[5.5rem_minmax(0,1fr)_auto] items-center gap-x-3 px-4 py-3">
		<span>
			@layouts.Status(state, tone)
		</span>
		<div class="min-w-0">
			<p class="text-sm font-medium">{ label }</p>
			if detail != "" {
				<p class={ "text-muted-foreground truncate text-xs", templ.KV("font-mono", mono) }>{ detail }</p>
			}
		</div>
		if href != "" {
			@button.Button(button.Props{Href: href, Variant: button.VariantOutline, Size: button.SizeSm}) {
				{ action }
			}
		}
	</li>
}

// statCard is one number on the Overview strip. A tile rather than a row in a
// table: the number is the point, and a table buries it in a column.
templ statCard(s dashStat) {
	<div class="bg-card rounded-xl border p-4">
		<div class="text-muted-foreground flex items-center justify-between gap-2 text-xs font-medium">
			<span class="truncate">{ s.Label }</span>
			@s.Icon(icon.Props{Class: "size-4 shrink-0"})
		</div>
		<p class="mt-2 text-2xl leading-none font-semibold tracking-tight tabular-nums">{ s.Value }</p>
		<p class="text-muted-foreground mt-1.5 truncate text-xs">{ s.Caption }</p>
	</div>
}
