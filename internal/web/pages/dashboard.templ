package pages

import (
	"github.com/openpreflight/openpreflight/internal/web"
	"github.com/openpreflight/openpreflight/internal/web/components/badge"
	"github.com/openpreflight/openpreflight/internal/web/components/button"
	"github.com/openpreflight/openpreflight/internal/web/components/card"
	"github.com/openpreflight/openpreflight/internal/web/components/empty"
	"github.com/openpreflight/openpreflight/internal/web/components/icon"
	"github.com/openpreflight/openpreflight/internal/web/layouts"
)

templ Dashboard(p web.Page) {
	{{ m := asMap(p.Data) }}
	{{ settings := settingsOf(m) }}
	{{ apps := appsOf(m) }}
	{{ coolify := coolifyOf(m) }}
	{{ bindings := bindingsOf(m) }}
	{{ enabled := asInt(m, "EnabledBindings") }}
	{{ inflight := inflightOf(m) }}
	{{ jobs := jobsOf(m) }}
	{{ cards := cardsOf(m) }}
	{{ recent := recentOf(m) }}
	{{ ranAny := asBool(m, "RanAny") }}
	{{ passedAny := asBool(m, "PassedAny") }}
	@layouts.Shell(p) {
		@layouts.PageHead("Overview", "Set the public URL, add your CI GitHub App, then enable the repos it should check. Coolify is optional.") {
			if dashNeedApp(len(apps)) {
				@button.Button(button.Props{Href: "/github-apps/new", Size: button.SizeSm}) {
					Add GitHub App
				}
			}
			if dashNeedRepo(len(apps), enabled) {
				@button.Button(button.Props{Href: "/repos", Size: button.SizeSm}) {
					Enable a repo
				}
			}
			if dashHaveSetup(len(apps), enabled) {
				@button.Button(button.Props{Href: "/jobs", Size: button.SizeSm}) {
					View jobs
				}
			}
		}
		if len(recent) > 0 {
			<div class="mb-6 grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
				for _, s := range dashStats(recent, len(inflight), enabled, len(bindings)) {
					@statCard(s)
				}
			</div>
		}
		if !dashSetupDone(settings.PublicBaseURL, len(apps), enabled, passedAny) {
			@layouts.SectionHead("Setup")
			@card.Card(card.Props{Class: "mb-6"}) {
				@card.Content() {
					<ul class="m-0 flex list-none flex-col divide-y p-0">
						if settings.PublicBaseURL != "" {
							@setupRow(badge.VariantDefault, "done", "Public base URL", settings.PublicBaseURL, true, "/settings", "Settings")
						} else {
							@setupRow(badge.VariantOutline, "needed", "Public base URL", "", false, "/settings", "Set it in Settings")
						}
						if len(apps) > 0 {
							@setupRow(badge.VariantDefault, "done", "CI GitHub App", itoa(len(apps))+" configured", false, "/github-apps", "Manage")
						} else {
							@setupRow(badge.VariantOutline, "needed", "CI GitHub App", "", false, "/github-apps/new", "Add one")
						}
						if enabled > 0 {
							@setupRow(badge.VariantDefault, "done", "Enabled repo", itoa(enabled)+" of "+itoa(len(bindings))+" enabled", false, "/repos", "Manage")
						} else {
							@setupRow(badge.VariantOutline, "needed", "Enabled repo", dashNoRepoHint(len(bindings)), false, "/repos", "Enable a repo")
						}
						if ranAny {
							@setupRow(badge.VariantDefault, "done", "First run", "", false, "/jobs", "View jobs")
						} else {
							@setupRow(badge.VariantOutline, "waiting", "First run", "push a commit, and GitHub calls the webhook", false, "", "")
						}
						if passedAny {
							@setupRow(badge.VariantDefault, "done", "Passing Check Run", "", false, "", "")
						} else if ranAny {
							@setupRow(badge.VariantOutline, "not yet", "Passing Check Run", "a run finished, but none has passed — open it to see why", false, "", "")
						} else {
							@setupRow(badge.VariantOutline, "waiting", "Passing Check Run", "the commit gets a green check here and on GitHub", false, "", "")
						}
						if len(coolify) > 0 {
							@setupRow(badge.VariantDefault, "done", "Coolify", itoa(len(coolify))+" configured · optional", false, "/coolify", "Manage")
						} else {
							@setupRow(badge.VariantSecondary, "optional", "Coolify", "server inventory and a repo picker", false, "/coolify", "Add an instance")
						}
					</ul>
				}
			}
		}
		@layouts.SectionHead("Active runs") {
			@button.Button(button.Props{Href: "/jobs", Variant: button.VariantLink, Size: button.SizeSm}) {
				View jobs
			}
		}
		@card.Card(card.Props{Class: "mb-6"}) {
			@card.Content() {
				if len(inflight) > 0 {
					@jobTable(inflight, true)
				} else {
					@empty.Empty(empty.Props{Class: emptyInCardClass}) {
						@empty.Header() {
							@empty.Media(empty.MediaProps{Variant: empty.MediaVariantIcon}) {
								@icon.Workflow()
							}
							@empty.Title() {
								No jobs queued or running
							}
							@empty.Description() {
								Queued and in-flight runs show up here. Finished work is under Recent jobs.
							}
						}
					}
				}
			}
		}
		@layouts.SectionHead("Recent jobs")
		@card.Card(card.Props{Class: "mb-6"}) {
			@card.Content() {
				if len(jobs) > 0 {
					@jobTable(jobs, true)
				} else {
					@empty.Empty(empty.Props{Class: emptyInCardClass}) {
						@empty.Header() {
							@empty.Media(empty.MediaProps{Variant: empty.MediaVariantIcon}) {
								@icon.Inbox()
							}
							@empty.Title() {
								No jobs yet
							}
							@empty.Description() {
								A job appears when GitHub sends a check_suite for an enabled repo.
							}
						}
						@empty.Content() {
							@button.Button(button.Props{Href: "/repos", Size: button.SizeSm}) {
								Enable a repo
							}
						}
					}
				}
			}
		}
		if len(cards) > 0 {
			@layouts.SectionHead("Enabled repos") {
				@button.Button(button.Props{Href: "/repos", Variant: button.VariantLink, Size: button.SizeSm}) {
					View all
				}
			}
			<div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
				for _, c := range cards {
					@card.Card(card.Props{Size: card.SizeSm}) {
						@card.Header() {
							@card.Title(card.TitleProps{Class: "font-mono truncate"}) {
								// The repo's own page, not its last run: the card is
								// about the repository, and one commit is not.
								<a class="hover:underline" href={ templ.SafeURL("/repos/" + itoa64(c.ID)) } title={ c.Repo }>{ c.Repo }</a>
							}
						}
						@card.Content() {
							@LastRun(c.LastJob)
						}
					}
				}
			</div>
		}
	}
}

// setupRow is one line of the setup checklist. The state badge sits in a fixed
// column so every label starts at the same x, whatever the badge says.
templ setupRow(variant badge.Variant, state, label, detail string, mono bool, href, action string) {
	<li class="grid grid-cols-[4.5rem_1fr] items-baseline gap-x-3 py-3 first:pt-0 last:pb-0">
		<span>
			@badge.Badge(badge.Props{Variant: variant}) {
				{ state }
			}
		</span>
		<div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
			<span>{ label }</span>
			if detail != "" {
				if mono {
					<span class="text-muted-foreground font-mono text-xs">{ detail }</span>
				} else {
					<span class="text-muted-foreground text-xs">{ detail }</span>
				}
			}
			if href != "" {
				@button.Button(button.Props{Href: href, Variant: button.VariantLink, Size: button.SizeSm, Class: "h-auto px-0"}) {
					{ action }
				}
			}
		</div>
	</li>
}

// statCard is one number on the Overview strip. A tile rather than a row in a
// table: the number is the point, and a table buries it in a column.
templ statCard(s dashStat) {
	@card.Card() {
		@card.Content(card.ContentProps{Class: "flex flex-col gap-1"}) {
			<div class="flex items-center justify-between gap-2">
				<span class="text-muted-foreground text-xs font-medium">{ s.Label }</span>
				@icon.Icon(s.Icon)(icon.Props{Class: "text-muted-foreground size-4 shrink-0"})
			</div>
			<span class="text-2xl leading-none font-semibold tracking-tight tabular-nums">{ s.Value }</span>
			<span class="text-muted-foreground text-xs">{ s.Caption }</span>
		}
	}
}
