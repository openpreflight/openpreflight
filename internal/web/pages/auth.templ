package pages

import (
	"github.com/openpreflight/openpreflight/internal/build"
	"github.com/openpreflight/openpreflight/internal/web"
	"github.com/openpreflight/openpreflight/internal/web/components/button"
	"github.com/openpreflight/openpreflight/internal/web/components/empty"
	"github.com/openpreflight/openpreflight/internal/web/components/icon"
	"github.com/openpreflight/openpreflight/internal/web/components/input"
	"github.com/openpreflight/openpreflight/internal/web/layouts"
)

templ Login(p web.Page) {
	@layouts.Auth(p) {
		@authCard("Sign in", "Operator for this worker. The account lives on this host.") {
			<form method="post" action="/api/v1/login">
				@layouts.CSRF(p.CSRFToken)
				<div class="flex flex-col gap-4 p-4">
					@authField("username", "Username", "") {
						@input.Input(input.Props{
							ID:         "username",
							Name:       "username",
							Type:       "text",
							Required:   true,
							Attributes: templ.Attributes{"autocomplete": "username", "autofocus": ""},
						})
					}
					@authField("password", "Password", "") {
						@input.Input(input.Props{
							ID:         "password",
							Name:       "password",
							Type:       "password",
							Required:   true,
							Attributes: templ.Attributes{"autocomplete": "current-password"},
						})
					}
				</div>
				@authSubmit("Sign in")
			</form>
		}
		<p class="text-muted-foreground text-center font-mono text-xs">openpreflight { build.Version }</p>
	}
}

templ Setup(p web.Page) {
	{{ m := asMap(p.Data) }}
	@layouts.Auth(p) {
		@authCard("Create the admin account", "One username, one password, and the URL GitHub will call. Apps and repositories come next.") {
			<form method="post" action="/api/v1/setup">
				@layouts.CSRF(p.CSRFToken)
				<div class="flex flex-col gap-5 p-4">
					@authField("setup_token", "Setup token", setupTokenHint) {
						@input.Input(input.Props{
							ID:         "setup_token",
							Name:       "setup_token",
							Type:       "text",
							Class:      "font-mono",
							Required:   true,
							Attributes: templ.Attributes{"autocomplete": "off", "spellcheck": "false", "autofocus": ""},
						})
					}
					@authField("username", "Admin username", "") {
						@input.Input(input.Props{
							ID:         "username",
							Name:       "username",
							Type:       "text",
							Value:      "admin",
							Required:   true,
							Attributes: templ.Attributes{"autocomplete": "username"},
						})
					}
					@authField("password", "Password", setupPasswordHint) {
						@input.Input(input.Props{
							ID:         "password",
							Name:       "password",
							Type:       "password",
							Required:   true,
							Attributes: templ.Attributes{"minlength": "12", "autocomplete": "new-password"},
						})
					}
					@authField("public_base_url", "Public base URL", setupURLHint) {
						@input.Input(input.Props{
							ID:          "public_base_url",
							Name:        "public_base_url",
							Type:        "url",
							Class:       "font-mono",
							Placeholder: "https://ci.example.com",
							Value:       str(m, "PublicBaseURL"),
							Required:    true,
						})
					}
				</div>
				@authSubmit("Create admin and continue")
			</form>
		}
		<p class="text-muted-foreground text-center text-xs">You can change the public URL later in Settings.</p>
	}
}

// authCard is the signed-out pages' panel: the same two tones as every
// ListCard, title on the frame and the form inset. The narrow column keeps
// fields stacked, so there is no label-left row here.
templ authCard(title, lede string) {
	@layouts.ListCard() {
		<div data-slot="list-head" class="px-3 pt-2.5 pb-3">
			<h1 class="text-lg font-semibold tracking-tight">{ title }</h1>
			if lede != "" {
				<p class="text-muted-foreground mt-1 text-sm text-pretty">{ lede }</p>
			}
		</div>
		{ children... }
	}
}

templ authField(id, label, hint string) {
	<div class="flex flex-col gap-1.5">
		<label for={ id } class="text-sm font-medium">{ label }</label>
		{ children... }
		if hint != "" {
			<p class="text-muted-foreground text-xs leading-relaxed text-pretty">{ hint }</p>
		}
	</div>
}

templ authSubmit(label string) {
	<div class="bg-muted/30 border-t px-4 py-3">
		@button.Button(button.Props{Type: button.TypeSubmit, Class: "w-full"}) {
			{ label }
		}
	</div>
}

templ Error(p web.Page) {
	{{ m := asMap(p.Data) }}
	if p.User != nil {
		@layouts.Shell(p) {
			// A PageHead on its own leaves the operator on a page that is
			// mostly blank and says nothing about what to do next.
			@layouts.PageHead(str(m, "Heading"), "")
			@empty.Empty(empty.Props{Class: emptyPageClass}) {
				@empty.Header() {
					@empty.Media(empty.MediaProps{Variant: empty.MediaVariantIcon}) {
						@icon.CircleAlert()
					}
					@empty.Title() {
						{ str(m, "Heading") }
					}
					@empty.Description() {
						{ str(m, "Message") }
					}
				}
				@empty.Content() {
					@button.Button(button.Props{Href: "/", Size: button.SizeSm}) {
						Back to overview
					}
					@button.Button(button.Props{Href: "/jobs", Variant: button.VariantOutline, Size: button.SizeSm}) {
						View jobs
					}
				}
			}
		}
	} else {
		@layouts.Guest(p) {
			<div class="mx-auto max-w-[440px]">
				@authCard(str(m, "Heading"), str(m, "Message")) {
					<div class="bg-muted/30 px-4 py-3">
						@button.Button(button.Props{Href: "/login", Size: button.SizeSm}) {
							Sign in
						}
					</div>
				}
			</div>
		}
	}
}
