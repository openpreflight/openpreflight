package pages

import (
	"github.com/openpreflight/openpreflight/internal/web"
	"github.com/openpreflight/openpreflight/internal/web/components/button"
	"github.com/openpreflight/openpreflight/internal/web/components/input"
	"github.com/openpreflight/openpreflight/internal/web/layouts"
)

templ Settings(p web.Page) {
	{{ m := asMap(p.Data) }}
	{{ section := settingsSectionOf(m) }}
	@layouts.Shell(p) {
		switch section {
			case "runner":
				@settingsShell("runner", "Runner", "How many jobs this process runs at once, the default Docker image, and fork PRs.") {
					@settingsRunner(p)
				}
			case "logs":
				@settingsShell("logs", "Logs", "How large a job log may grow, and how long rows are kept.") {
					@settingsLogs(p)
				}
			case "admin":
				@settingsShell("admin", "Admin", "Change the operator password.") {
					@settingsAdmin(p)
				}
			default:
				@settingsShell("configuration", "Settings", "Global defaults. A repo binding overrides its GitHub App, which overrides these.") {
					@settingsConfiguration(p)
				}
		}
	}
}

templ settingsShell(section, title, lede string) {
	@layouts.PageHead(title, lede)
	<div class="grid gap-6 lg:grid-cols-[12rem_minmax(0,1fr)]">
		@settingsNav(section)
		<div class="space-y-6">
			{ children... }
		</div>
	</div>
}

templ settingsNav(current string) {
	<nav class="text-sm lg:sticky lg:top-20 lg:self-start" aria-label="Settings">
		<ul class="flex flex-row gap-1 overflow-x-auto pb-1 lg:flex-col lg:overflow-visible lg:pb-0">
			@settingsNavItem("/settings", "Configuration", current == "configuration")
			@settingsNavItem("/settings/runner", "Runner", current == "runner")
			@settingsNavItem("/settings/logs", "Logs", current == "logs")
			@settingsNavItem("/settings/admin", "Admin", current == "admin")
		</ul>
	</nav>
}

templ settingsNavItem(href, label string, active bool) {
	<li>
		if active {
			<a class="bg-muted text-foreground block whitespace-nowrap rounded-md px-3 py-1.5 font-medium" href={ templ.SafeURL(href) } aria-current="page">{ label }</a>
		} else {
			<a class="text-muted-foreground hover:bg-muted hover:text-foreground block whitespace-nowrap rounded-md px-3 py-1.5" href={ templ.SafeURL(href) }>{ label }</a>
		}
	</li>
}

// Each settings page is one form: a panel of label-left rows, the same as
// the repository editor, with Save at the foot of the panel it saves.
templ settingsConfiguration(p web.Page) {
	{{ m := asMap(p.Data) }}
	{{ settings := settingsOf(m) }}
	@settingsForm(p, "/settings", "Save changes") {
		@fieldRow("public_base_url", "Public base URL", settingsURLHint()) {
			@input.Input(input.Props{ID: "public_base_url", Name: "public_base_url", Type: "url", Class: "font-mono", Value: settings.PublicBaseURL, Placeholder: "https://ci.example.com", Attributes: noAutofill})
		}
		@fieldRow("default_check_name", "Default check name", "What GitHub shows next to a commit when neither the App nor the repo names the check.") {
			@input.Input(input.Props{ID: "default_check_name", Name: "default_check_name", Type: "text", Value: settings.DefaultCheckName, Attributes: noAutofill})
		}
		@fieldRow("default_pipeline_file", "Default pipeline file", "Read from the commit being checked when the repo does not name its own.") {
			@input.Input(input.Props{ID: "default_pipeline_file", Name: "default_pipeline_file", Type: "text", Class: "font-mono", Value: settings.DefaultPipelineFile, Attributes: noAutofill})
		}
		@fieldRow("default_timeout_seconds", "Default timeout", "Now "+secondsLabel(settings.DefaultTimeoutSeconds)+". A job still running after this is stopped and fails. At least 30 seconds.") {
			@unitInput("seconds") {
				@input.Input(input.Props{ID: "default_timeout_seconds", Name: "default_timeout_seconds", Type: "number", Class: "w-32", Value: itoa(settings.DefaultTimeoutSeconds), Attributes: templ.Attributes{"min": "30", "inputmode": "numeric"}})
			}
		}
	}
}

templ settingsRunner(p web.Page) {
	{{ m := asMap(p.Data) }}
	{{ settings := settingsOf(m) }}
	{{ dockerOK := asBool(m, "DockerAvailable") }}
	{{ dockerHost := str(m, "DockerHost") }}
	// The handler tells this form apart by max_concurrent_jobs: an unchecked
	// box posts nothing, so that field is what makes "off" mean off.
	@settingsForm(p, "/settings/runner", "Save changes") {
		@fieldRow("max_concurrent_jobs", "Max concurrent jobs", "How many jobs this process runs at once. The rest wait in the queue. 1 to 32.") {
			@input.Input(input.Props{ID: "max_concurrent_jobs", Name: "max_concurrent_jobs", Type: "number", Class: "w-32", Value: itoa(settings.MaxConcurrentJobs), Attributes: templ.Attributes{"min": "1", "max": "32", "inputmode": "numeric"}})
		}
		@fieldRow("default_runtime", "Default Docker runtime", dockerHint(dockerOK, dockerHost)) {
			@input.Input(input.Props{ID: "default_runtime", Name: "default_runtime", Type: "text", Class: "font-mono", Value: settings.DefaultRuntime, Placeholder: "node:24", Attributes: noAutofill})
		}
		@switchRow("skip_fork_prs", "skip_fork_prs", "Skip fork pull requests", "Leave on unless Docker is working and a default runtime is set. Fork jobs always run in Docker.", settings.SkipForkPRs, false)
	}
}

templ settingsLogs(p web.Page) {
	{{ m := asMap(p.Data) }}
	{{ settings := settingsOf(m) }}
	@settingsForm(p, "/settings/logs", "Save changes") {
		@fieldRow("max_log_bytes", "Max log size per job", "Now "+humanBytes(settings.MaxLogBytes)+". The log stops growing at this size; the run carries on.") {
			@unitInput("bytes") {
				@input.Input(input.Props{ID: "max_log_bytes", Name: "max_log_bytes", Type: "number", Class: "w-40", Value: itoa64(settings.MaxLogBytes), Attributes: templ.Attributes{"min": "4096", "inputmode": "numeric"}})
			}
		}
		@fieldRow("log_retention_days", "Log retention", retentionLabel(settings.LogRetentionDays)+" Job rows and log files older than this are pruned hourly.") {
			@unitInput("days") {
				@input.Input(input.Props{ID: "log_retention_days", Name: "log_retention_days", Type: "number", Class: "w-32", Value: itoa(settings.LogRetentionDays), Attributes: templ.Attributes{"min": "1", "max": "3650", "inputmode": "numeric"}})
			}
		}
	}
}

templ settingsAdmin(p web.Page) {
	<form method="post" action="/api/v1/password">
		@layouts.CSRF(p.CSRFToken)
		@layouts.ListCard() {
			<div>
				<div class="divide-y">
					@fieldRow("password", "New password", "At least 12 characters. Every other session is signed out.") {
						@input.Input(input.Props{
							ID:         "password",
							Name:       "password",
							Type:       "password",
							Required:   true,
							Attributes: templ.Attributes{"minlength": "12", "autocomplete": "new-password"},
						})
					}
				</div>
				@settingsSave("Update password")
			</div>
		}
	</form>
}

// settingsForm is one settings section: its rows in a panel, Save at the foot.
templ settingsForm(p web.Page, next, label string) {
	<form id="settings-form" method="post" action="/api/v1/settings">
		@layouts.CSRF(p.CSRFToken)
		<input type="hidden" name="next" value={ next }/>
		@layouts.ListCard() {
			<div>
				<div class="divide-y">
					{ children... }
				</div>
				@settingsSave(label)
			</div>
		}
	</form>
}

// settingsSave ends every settings panel: a rule, then the button, next to
// the fields it saves rather than in the page header.
templ settingsSave(label string) {
	<div class="bg-muted/30 flex justify-end border-t px-4 py-3">
		@button.Button(button.Props{Type: button.TypeSubmit, Size: button.SizeSm}) {
			{ label }
		}
	</div>
}
