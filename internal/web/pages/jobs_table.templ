package pages

import (
	"github.com/openpreflight/openpreflight/internal/store"
	"github.com/openpreflight/openpreflight/internal/web"
	"github.com/openpreflight/openpreflight/internal/web/components/button"
	"github.com/openpreflight/openpreflight/internal/web/components/empty"
	"github.com/openpreflight/openpreflight/internal/web/components/icon"
	"github.com/openpreflight/openpreflight/internal/web/components/table"
	"github.com/openpreflight/openpreflight/internal/web/layouts"
)

templ jobsTable(p web.Page, list []store.Job, filtered bool) {
	if len(list) == 0 {
		if filtered {
			@empty.Empty(empty.Props{Class: emptyInCardClass}) {
				@empty.Header() {
					@empty.Media(empty.MediaProps{Variant: empty.MediaVariantIcon}) {
						@icon.Search()
					}
					@empty.Title() {
						No jobs match this filter
					}
					@empty.Description() {
						Try a different repo or status, or clear the filter to see every run.
					}
				}
				@empty.Content() {
					@button.Button(button.Props{Href: "/jobs", Size: button.SizeSm}) {
						Clear filters
					}
				}
			}
		} else {
			@empty.Empty(empty.Props{Class: emptyInCardClass}) {
				@empty.Header() {
					@empty.Media(empty.MediaProps{Variant: empty.MediaVariantIcon}) {
						@icon.Workflow()
					}
					@empty.Title() {
						No jobs yet
					}
					@empty.Description() {
						GitHub creates one by sending a check_suite for a repo with an enabled binding.
					}
				}
				@empty.Content() {
					@button.Button(button.Props{Href: "/repos", Size: button.SizeSm}) {
						Enable a repo
					}
				}
			}
		}
	} else {
		@table.Table() {
			@table.Header(table.HeaderProps{Class: "sticky top-0 z-10 bg-card"}) {
				@table.Row() {
					@table.Head() {
						Status
					}
					@table.Head() {
						Repo
					}
					@table.Head(table.HeadProps{Class: "hidden lg:table-cell"}) {
						Event
					}
					@table.Head() {
						Took
					}
					@table.Head() {
						When
					}
					@table.Head() {
						<span class="sr-only">Actions</span>
					}
				}
			}
			@table.Body() {
				for _, j := range list {
					@jobsRow(p, j)
				}
			}
		}
	}
}

templ jobsRow(p web.Page, j store.Job) {
	@table.Row() {
		@table.Cell() {
			@StatusBadge(j)
			if j.Error != "" {
				<div class="text-muted-foreground max-w-[16rem] truncate text-xs">{ j.Error }</div>
			}
		}
		@table.Cell() {
			<a class="font-mono text-sm font-medium hover:text-foreground hover:underline" href={ templ.SafeURL("/runs/" + j.ID) }>{ j.Repo }</a>
			<div class="text-muted-foreground font-mono text-xs">{ jobRefLine(j) }</div>
		}
		@table.Cell(table.CellProps{Class: "text-muted-foreground hidden max-w-[12rem] truncate text-xs lg:table-cell"}) {
			{ j.Event }
		}
		@table.Cell(table.CellProps{Class: "tabular-nums text-xs"}) {
			if j.StartedAt != nil {
				{ web.HumanDuration(j.Duration()) }
			} else {
				{ "-" }
			}
		}
		@table.Cell(table.CellProps{Class: "text-muted-foreground tabular-nums text-xs"}) {
			{ web.Ago(j.CreatedAt) }
		}
		@table.Cell(table.CellProps{Class: "whitespace-nowrap"}) {
			<div class="flex items-center gap-2">
				@button.Button(button.Props{Href: "/runs/" + j.ID, Variant: button.VariantLink, Size: button.SizeSm}) {
					Logs
				}
				<form method="post" action={ templ.SafeURL("/api/v1/jobs/" + j.ID + "/rerun") } class="m-0">
					@layouts.CSRF(p.CSRFToken)
					@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantLink, Size: button.SizeSm}) {
						Re-run
					}
				</form>
				if jobInFlight(j) {
					<form method="post" action={ templ.SafeURL("/api/v1/jobs/" + j.ID + "/cancel") } class="m-0">
						@layouts.CSRF(p.CSRFToken)
						@button.Button(button.Props{Type: button.TypeSubmit, Variant: button.VariantGhost, Size: button.SizeSm, Class: "text-destructive"}) {
							Cancel
						}
					</form>
				}
			</div>
		}
	}
}

templ jobTable(jobs []store.Job) {
	@table.Table() {
		@table.Header(table.HeaderProps{Class: "sticky top-0 z-10 bg-card"}) {
			@table.Row() {
				@table.Head() {
					Status
				}
				@table.Head() {
					Repo
				}
				@table.Head() {
					When
				}
				@table.Head() {
					<span class="sr-only">Actions</span>
				}
			}
		}
		@table.Body() {
			for _, j := range jobs {
				@table.Row() {
					@table.Cell() {
						@StatusBadge(j)
					}
					@table.Cell() {
						<a class="font-mono text-sm font-medium hover:text-foreground hover:underline" href={ templ.SafeURL("/runs/" + j.ID) }>{ j.Repo }</a>
						<div class="text-muted-foreground font-mono text-xs">{ jobRefLine(j) }</div>
					}
					@table.Cell(table.CellProps{Class: "text-muted-foreground tabular-nums text-xs"}) {
						{ web.Ago(j.CreatedAt) }
					}
					@table.Cell(table.CellProps{Class: "whitespace-nowrap"}) {
						@button.Button(button.Props{Href: "/runs/" + j.ID, Variant: button.VariantLink, Size: button.SizeSm}) {
							Logs
						}
					}
				}
			}
		}
	}
}
